diff --git a/iokit/Kernel/arm/VivaEnergy.cpp b/iokit/Kernel/arm/VivaEnergy.cpp
new file mode 100644
index 0000000..1d600a5
--- /dev/null
+++ b/iokit/Kernel/arm/VivaEnergy.cpp
@@ -0,0 +1,198 @@
+/*
+ * viva (0231): IOReport group "Energy Model", the per-subsystem energy that PowerLog (aggregated, PLIOReportAgent /
+ * PLAPEnergyService) turns into the accounting power events behind Settings > Battery. On an iPhone the PMGR driver
+ * publishes it; without any channel every root node (CPU, GPU, DRAM, SoC) had 0 power, powerlogHelperd bailed with
+ * "totalAccountedEnergySum=0" and the per-app list stayed empty (PLBatteryUIErrorCodeKey 1).
+ *
+ * What PowerLog reads (20H392, static analysis of PowerlogLiteOperators): every service with IOReportLegendPublic
+ * is scanned once when aggregated starts; channels of group "Energy Model" WITHOUT a subgroup; simple channels, the
+ * raw delta of each sample taken as mJ (no unit scaling), power = delta / PowerLog's own sample interval (at most one
+ * sample per 300 s, on battery level changes); a power above 10 W is dropped. The names depend on the SoC class of
+ * the device MobileGestalt reports; for the A11 class: ECPU + PCPU -> CPU (node 2, both needed), DRAM + DCS -> DRAM
+ * (node 9, both needed), "GPU Energy" -> GPU (node 8, in nJ: PowerLog multiplies it by 1e-6), SOC_REST -> SoC
+ * (node 7), SOC_AON -> APSOCBase (node 54, PowerLog forces it to 30 mW). "GPU" (mJ) is the GPU for newer classes and
+ * ignored on A11. "CPU Energy" / "DRAM Energy" are NOT published: older classes would count them twice.
+ *
+ * The values are estimates, not measurements (this SoC has no energy counters the port reads):
+ *   ECPU/PCPU  per CPU busy time (recount, viva_cpufreq.c cluster_busy) x C * f * V^2 of the A55 / A76 cluster's OPP
+ *              (vivaenergyll, vivaenergybig, uW/MHz/V^2; LL's rail is max(LL, CCI)).
+ *   GPU        Mali busy time (VivaGPU.cpp completeJob) x C * f * VGPU^2 (vivaenergygpu).
+ *   SOC_REST   CCI at its OPP x the busier cluster's share (vivaenergycci).
+ *   DRAM/DCS   vivaenergydram per mille of CPU + GPU (traffic follows the work), 70 / 30 %.
+ * PowerLog splits each root node among the processes by their CPU time / GPU time, so the shares per app follow the
+ * real usage; the absolute numbers only set how the subsystems compare. The display is not here: PowerLog models it
+ * from AppleARMBacklight's BrightnessMicroAmps (SweetFramebuffer.cpp).
+ *
+ * Link: "energy" prints the totals. vivaenergy=0: no service (PowerLog as before).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOKernelReporters.h>
+#include <IOKit/IOLib.h>
+#include <libkern/OSAtomic.h>
+#include <pexpert/pexpert.h>
+
+/* accumulators, nJ */
+enum { VE_ECPU, VE_PCPU, VE_GPU, VE_DRAM, VE_SOC, VE_COUNT };
+static volatile uint64_t gVivaEnergyNJ[VE_COUNT];
+/* published channels: name, accumulator, share of it (per mille), nJ (else mJ) */
+static const struct { const char *name; int acc; uint32_t permille; bool nj; } kVivaEnergyCh[] = {
+	{ "ECPU", VE_ECPU, 1000, false }, { "PCPU", VE_PCPU, 1000, false }, { "GPU Energy", VE_GPU, 1000, true },
+	{ "GPU", VE_GPU, 1000, false }, { "DRAM", VE_DRAM, 700, false }, { "DCS", VE_DRAM, 300, false },
+	{ "SOC_REST", VE_SOC, 1000, false }, { "SOC_AON", VE_SOC, 0, false },
+};
+#define VE_CHANNELS     (sizeof(kVivaEnergyCh) / sizeof(kVivaEnergyCh[0]))
+#define VE_CHID(i)      (0x5645000000000001ULL + (i))   /* 'VE' + index (this XNU has no IOREPORT_MAKECHID) */
+static uint64_t gVivaEnergyPJ[VE_COUNT];        /* sub-nJ remainders of the adds below (same writer per channel) */
+static int gVivaEnergyCoef[4] = { 120, 420, 1300, 60 };   /* ll, big, gpu, cci: uW per MHz per V^2 */
+static int gVivaEnergyDram = 150;               /* per mille of CPU + GPU */
+static bool gVivaEnergyOn = true;
+
+static void
+viva_energy_add_pj(int ch, uint64_t pj)
+{
+	uint64_t total = gVivaEnergyPJ[ch] + pj;
+	gVivaEnergyPJ[ch] = total % 1000;
+	if (total >= 1000) {
+		OSAddAtomic64((SInt64)(total / 1000), (volatile SInt64 *)&gVivaEnergyNJ[ch]);
+	}
+}
+
+/*
+ * `ns` of activity at `mhz` and `uv` microvolts with coefficient index `k` (0 ll, 1 big, 2 gpu, 3 cci) on channel
+ * `ch`. P (mW) = C (uW/MHz/V^2) * MHz * V^2 / 1000; E (pJ) = P (mW) * t (ns).
+ */
+static void
+viva_energy_add(int ch, int k, uint64_t ns, uint32_t mhz, uint32_t uv)
+{
+	if (!gVivaEnergyOn || ns == 0) {
+		return;
+	}
+	uint64_t mv = uv / 1000;
+	uint64_t uw = (uint64_t)gVivaEnergyCoef[k] * mhz * mv * mv / 1000000;     /* uW */
+	uint64_t pj = uw * ns / 1000;
+	viva_energy_add_pj(ch, pj);
+	if (ch == VE_ECPU || ch == VE_PCPU || ch == VE_GPU) {
+		viva_energy_add_pj(VE_DRAM, pj * (uint64_t)gVivaEnergyDram / 1000);
+	}
+}
+
+/* viva_cpufreq.c, per CPU and governor window: busy `ns` of a CPU of cluster `big` at `mhz` / `uv`. */
+extern "C" void
+viva_energy_cpu(int big, uint64_t ns, uint32_t mhz, uint32_t uv)
+{
+	viva_energy_add(big ? VE_PCPU : VE_ECPU, big ? 1 : 0, ns, mhz, uv);
+}
+
+/* viva_cpufreq.c: the CCI for `ns` at `mhz` / `uv`, `busy` per mille (the busier cluster). */
+extern "C" void
+viva_energy_cci(uint64_t ns, uint32_t mhz, uint32_t uv, unsigned busy)
+{
+	viva_energy_add(VE_SOC, 3, ns * busy / 1000, mhz, uv);
+}
+
+/* VivaGPU.cpp: the GPU was busy `ns` at `mhz` / `uv` (VGPU). */
+extern "C" void
+viva_energy_gpu(uint64_t ns, uint32_t mhz, uint32_t uv)
+{
+	viva_energy_add(VE_GPU, 2, ns, mhz, uv);
+}
+
+/* USB link "energy" */
+extern "C" void
+viva_energy_status(char *out, size_t len)
+{
+	snprintf(out, len, "energy (mJ, estimates): ecpu %llu pcpu %llu gpu %llu dram %llu soc %llu; coef ll %d big %d gpu %d "
+	    "cci %d uW/MHz/V^2, dram %d permille%s\n", gVivaEnergyNJ[VE_ECPU] / 1000000, gVivaEnergyNJ[VE_PCPU] / 1000000,
+	    gVivaEnergyNJ[VE_GPU] / 1000000, gVivaEnergyNJ[VE_DRAM] / 1000000, gVivaEnergyNJ[VE_SOC] / 1000000, gVivaEnergyCoef[0], gVivaEnergyCoef[1], gVivaEnergyCoef[2], gVivaEnergyCoef[3],
+	    gVivaEnergyDram, gVivaEnergyOn ? "" : " (off)");
+}
+
+class VivaEnergy : public IOService {
+	OSDeclareDefaultStructors(VivaEnergy);
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+	IOReturn configureReport(IOReportChannelList *channels, IOReportConfigureAction action, void *result,
+	    void *destination) APPLE_KEXT_OVERRIDE;
+	IOReturn updateReport(IOReportChannelList *channels, IOReportConfigureAction action, void *result,
+	    void *destination) APPLE_KEXT_OVERRIDE;
+private:
+	IOSimpleReporter *fReporter;
+};
+OSDefineMetaClassAndStructors(VivaEnergy, IOService);
+
+bool
+VivaEnergy::start(IOService *provider)
+{
+	int on = 1, v;
+	PE_parse_boot_argn("vivaenergy", &on, sizeof(on));
+	if (on == 0) {
+		gVivaEnergyOn = false;
+		return false;
+	}
+	if (PE_parse_boot_argn("vivaenergyll", &v, sizeof(v))) {
+		gVivaEnergyCoef[0] = v;
+	}
+	if (PE_parse_boot_argn("vivaenergybig", &v, sizeof(v))) {
+		gVivaEnergyCoef[1] = v;
+	}
+	if (PE_parse_boot_argn("vivaenergygpu", &v, sizeof(v))) {
+		gVivaEnergyCoef[2] = v;
+	}
+	if (PE_parse_boot_argn("vivaenergycci", &v, sizeof(v))) {
+		gVivaEnergyCoef[3] = v;
+	}
+	if (PE_parse_boot_argn("vivaenergydram", &v, sizeof(v))) {
+		gVivaEnergyDram = v;
+	}
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	/* mJ for the legend; "GPU Energy" carries nJ (PowerLog ignores the unit of simple channels, see the top) */
+	fReporter = IOSimpleReporter::with(this, kIOReportCategoryPower, kIOReportUnit_mJ);
+	if (fReporter == NULL) {
+		return false;
+	}
+	for (unsigned i = 0; i < VE_CHANNELS; i++) {
+		if (fReporter->addChannel(VE_CHID(i), kVivaEnergyCh[i].name) != kIOReturnSuccess) {
+			return false;
+		}
+	}
+	if (IOReportLegend::addReporterLegend(this, fReporter, "Energy Model", NULL) != kIOReturnSuccess) {
+		return false;
+	}
+	setName("VivaEnergy");
+	registerService();
+	IOLog("VivaEnergy: Energy Model channels published (coef ll %d big %d gpu %d cci %d, dram %d)\n",
+	    gVivaEnergyCoef[0], gVivaEnergyCoef[1], gVivaEnergyCoef[2], gVivaEnergyCoef[3], gVivaEnergyDram);
+	return true;
+}
+
+void
+VivaEnergy::free(void)
+{
+	OSSafeReleaseNULL(fReporter);
+	IOService::free();
+}
+
+IOReturn
+VivaEnergy::configureReport(IOReportChannelList *channels, IOReportConfigureAction action, void *result,
+    void *destination)
+{
+	IOReturn ret = fReporter->configureReport(channels, action, result, destination);
+	return ret == kIOReturnSuccess ? IOService::configureReport(channels, action, result, destination) : ret;
+}
+
+IOReturn
+VivaEnergy::updateReport(IOReportChannelList *channels, IOReportConfigureAction action, void *result,
+    void *destination)
+{
+	for (unsigned i = 0; i < VE_CHANNELS; i++) {
+		uint64_t nj = gVivaEnergyNJ[kVivaEnergyCh[i].acc] / 1000 * kVivaEnergyCh[i].permille;
+		fReporter->setValue(VE_CHID(i), (int64_t)(kVivaEnergyCh[i].nj ? nj : nj / 1000000));
+	}
+	IOReturn ret = fReporter->updateReport(channels, action, result, destination);
+	return ret == kIOReturnSuccess ? IOService::updateReport(channels, action, result, destination) : ret;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */

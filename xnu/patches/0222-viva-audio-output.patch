+IOReturn
+VivaGPIO::setMode(uint32_t pin, uint32_t mode)
+{
+	bool allowed = false;
+	const uint32_t *pins = fModePins ? (const uint32_t *)fModePins->getBytesNoCopy() : NULL;
+	for (unsigned int i = 0; pins != NULL && i < fModePins->getLength() / 4; i++) {
+		allowed |= pins[i] == pin;
+	}
+	if (pin >= GPIO_PINS || mode > 7 || !allowed) {
+		IOLog("VIVA GPIO: refused mode %u on pin %u\n", mode, pin);
+		return kIOReturnNotPermitted;
+	}
+	uint32_t reg = GPIO_MODE + 0x10 * (pin / 8), shift = 4 * (pin % 8);
+	wr32(reg + GPIO_CLR, 0xfu << shift);
+	wr32(reg + GPIO_SET, mode << shift);
+	return kIOReturnSuccess;
+}
+
+IOReturn
+VivaGPIO::getMode(uint32_t pin, uint32_t *mode)
+{
+	if (pin >= GPIO_PINS || mode == NULL) {
+		return kIOReturnBadArgument;
+	}
+	*mode = (rd32(GPIO_MODE + 0x10 * (pin / 8)) >> (4 * (pin % 8))) & 0xf;
+	return kIOReturnSuccess;
+}

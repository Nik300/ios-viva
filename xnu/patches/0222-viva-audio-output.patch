+{
+	uint32_t allowed = 0;
+	if (addr >= 0x2200 && addr <= 0x24fe && (addr & 1) == 0) {
+		allowed = 0xffff;
+	}
+	for (unsigned int i = 0; i < sizeof(gVivaAudioRegs) / sizeof(gVivaAudioRegs[0]); i++) {
+		if (gVivaAudioRegs[i].addr == addr) {
+			allowed = gVivaAudioRegs[i].mask;
+		}
+	}
+	if (mask == 0 || (mask & ~allowed) || (value & ~mask)) {
+		IOLog("VIVA PWRAP: refused audio write 0x%04x mask 0x%x <- 0x%x\n", addr, mask, value);
+		return kIOReturnNotPermitted;
+	}
+	IOReturn ret = kIOReturnSuccess;
+	uint32_t old = 0;
+	IOLockLock(fLock);
+	if (mask != 0xffff) {
+		ret = readNoLock(addr, &old);
+	}
+	if (ret == kIOReturnSuccess) {
+		ret = kIOReturnTimeout;
+		if (WACS_FSM(rd32(PWRAP_WACS2_RDATA)) == WACS_FSM_WFVLDCLR) {
+			wr32(PWRAP_WACS2_VLDCLR, 1);
+		}
+		if (waitFSM(WACS_FSM_IDLE)) {
+			wr32(PWRAP_WACS2_CMD, 0x80000000u | ((addr >> 1) << 16) | (((old & ~mask) | value) & 0xffff));
+			ret = waitFSM(WACS_FSM_IDLE) ? kIOReturnSuccess : kIOReturnTimeout;
+		}
+	}
+	IOLockUnlock(fLock);
+	if (ret != kIOReturnSuccess) {
+		IOLog("VIVA PWRAP: audio write 0x%04x failed (0x%x)\n", addr, ret);
+	}
+	return ret;
+}

--- /dev/null
+++ b/iokit/Kernel/arm/viva_vdec_uapi.h
@@ -0,0 +1,60 @@
+// Viva VDEC: interface between the XNU driver (VivaVDEC, fork/xnu/patches/0213-viva-vdec-*) and userspace (the
+// clean-room decoder library, ~/Developer/ios-viva/vdec lib/). Shared by C (userspace) and C++ (kernel).
+//
+// The kernel knows no codec: userspace parses the bitstream and builds the register program of a picture
+// (vdec lib/vivavdec_h264, tools/refgen.py); the kernel checks every access against the VDEC register window and
+// executes the program on the hardware, waiting for the decode-done interrupt where the program says so.
+//
+// Transport: IOServiceOpen(type VVDEC_CLIENT_TYPE) on the service of class VVDEC_SERVICE_CLASS (root, or a task
+// with the entitlement VVDEC_ENTITLEMENT), then IOConnectCallScalarMethod with the selectors below.
+// Memory: IOConnectMapMemory64(type VVDEC_MAP_ARENA) maps the DMA arena (physically contiguous below 4 GiB, the
+// addresses the program writes are arena physical address + offset); type VVDEC_MAP_PROGRAM maps the program
+// buffer (struct vvdec_op[VVDEC_MAX_OPS]).
+//
+// DMA: the VDEC (larb4 ports 0-11) bypasses the M4U, so the addresses a program writes reach physical memory
+// unchecked; this is why only root or entitled tasks may open the service.
+#pragma once
+#include <stdint.h>
+
+#define VVDEC_SERVICE_CLASS     "VivaVDEC"
+#define VVDEC_CLIENT_TYPE       0x76646563u         // 'vdec'
+#define VVDEC_ENTITLEMENT       "com.viva.vdec"
+#define VVDEC_UAPI_VERSION      1
+
+#define VVDEC_WINDOW_BASE       0x16020000u         // VLD .. GCON; every op's pa must lie in [BASE, BASE + SIZE)
+#define VVDEC_WINDOW_SIZE       0x10000u
+#define VVDEC_MAX_OPS           16384
+#define VVDEC_MAP_ARENA         0
+#define VVDEC_MAP_PROGRAM       1
+
+enum vvdec_op_kind {
+	VVDEC_OP_WR   = 1,      // *pa = value
+	VVDEC_OP_RD   = 2,      // value = *pa (written back into the program: status reads, barrel-shifter reads)
+	VVDEC_OP_POLL = 3,      // read until (*pa & mask) == value, up to the run's timeout; the last read goes to mask
+	VVDEC_OP_IRQ  = 4,      // wait for decode done (VDEC_MISC+0xa4 bit 16), clear it (|0x11 then &~0x10);
+	                        // value = the status word
+};
+
+struct vvdec_op {
+	uint32_t kind;
+	uint32_t pa;
+	uint32_t value;
+	uint32_t mask;
+};
+
+enum vvdec_selector {
+	VVDEC_SEL_INFO  = 0,    // out: version, VDE powered, pool PA (boot-arg vivavdecpool), pool size
+	VVDEC_SEL_POWER = 1,    // in: 1 on / 0 off (off only when no other client keeps it on)
+	VVDEC_SEL_ARENA = 2,    // in: size; out: physical address, size (once per connection; the boot pool if free)
+	VVDEC_SEL_SYNC  = 3,    // in: arena offset, length: write back + invalidate the CPU caches for that range
+	VVDEC_SEL_RUN   = 4,    // in: number of ops, timeout ms; out: status (vvdec_status), index of the failing op,
+	                        //     decode-done status word, microseconds waiting for the hardware, total microseconds
+};
+
+enum vvdec_status {
+	VVDEC_OK          = 0,
+	VVDEC_ERR_ADDRESS = 1,  // op outside the register window or not 4-byte aligned
+	VVDEC_ERR_KIND    = 2,
+	VVDEC_ERR_TIMEOUT = 3,  // POLL or IRQ timed out
+	VVDEC_ERR_POWER   = 4,  // VDE is off
+};

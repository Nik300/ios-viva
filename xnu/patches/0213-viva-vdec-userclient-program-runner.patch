+static uint64_t
+nowUs(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000;
+}
+
+/*
+ * The register program of one picture (viva_vdec_uapi.h). Every op is checked before the first one runs. Polls and
+ * the decode-done wait first spin (a decode takes a few ms), then sleep a millisecond at a time. Caller holds gLock
+ * (sleeping with it is fine: the link and the clients serialize on it anyway).
+ */
+static uint32_t
+runProgram(struct vvdec_op *ops, uint32_t n, uint32_t timeoutMs, uint32_t out[5])
+{
+	uint64_t t0 = nowUs(), hw = 0;
+	out[0] = VVDEC_OK;
+	out[1] = out[2] = out[3] = out[4] = 0;
+	if (!vdePowered()) {
+		return out[0] = VVDEC_ERR_POWER;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		uint32_t off = ops[i].pa - VVDEC_WINDOW_BASE;
+		if (ops[i].kind < VVDEC_OP_WR || ops[i].kind > VVDEC_OP_IRQ) {
+			out[1] = i;
+			return out[0] = VVDEC_ERR_KIND;
+		}
+		if (ops[i].kind != VVDEC_OP_IRQ && (off >= VVDEC_WINDOW_SIZE || (off & 3))) {
+			out[1] = i;
+			return out[0] = VVDEC_ERR_ADDRESS;
+		}
+	}
+	uint64_t limit = (uint64_t)(timeoutMs ? timeoutMs : 1000) * 1000;
+	for (uint32_t i = 0; i < n; i++) {
+		struct vvdec_op *op = &ops[i];
+		uint32_t off = op->pa - VVDEC_WINDOW_BASE;
+		if (op->kind == VVDEC_OP_WR) {
+			wr(gWin, off, op->value);
+		} else if (op->kind == VVDEC_OP_RD) {
+			op->value = rd(gWin, off);
+		} else {
+			bool irq = op->kind == VVDEC_OP_IRQ;
+			uint32_t at = irq ? VDEC_IRQ_CFG : off, mask = irq ? VDEC_IRQ_DONE : op->mask;
+			uint32_t want = irq ? VDEC_IRQ_DONE : op->value, v = 0;
+			uint64_t s = nowUs();
+			for (uint32_t spin = 0;; spin++) {
+				v = rd(gWin, at);
+				if ((v & mask) == want) {
+					break;
+				}
+				if (nowUs() - s > limit) {
+					out[1] = i;
+					out[2] = v;
+					return out[0] = VVDEC_ERR_TIMEOUT;
+				}
+				if (spin < 400) {
+					IODelay(5);
+				} else {
+					IOSleep(1);
+				}
+			}
+			if (irq) {
+				hw += nowUs() - s;
+				wr(gWin, VDEC_IRQ_CFG, rd(gWin, VDEC_IRQ_CFG) | 0x11);
+				wr(gWin, VDEC_IRQ_CFG, rd(gWin, VDEC_IRQ_CFG) & ~0x10u);
+				op->value = out[2] = v;
+			} else {
+				op->mask = v;
+			}
+		}
+	}
+	out[3] = (uint32_t)hw;
+	out[4] = (uint32_t)(nowUs() - t0);
+	return VVDEC_OK;
+}
+
+/* "vdec run OFF N [MS]": the program at pool offset OFF. Caller holds gLock. */
+static void
+runCmd(const char *args, char *out, size_t len, size_t *po)
+{
+	size_t o = *po;
+#define SAY(...) do { if (o < len) o += (size_t)snprintf(out + o, len - o, __VA_ARGS__); } while (0)
+	uint64_t off = 0, n = 0, ms = 0;
+	const char *p = num(args + 3, &off);
+	p = p != NULL ? num(p, &n) : NULL;
+	if (p != NULL) {
+		num(p, &ms);
+	}
+	if (gPool == NULL) {
+		SAY("vdec: no pool (boot-arg vivavdecpool=MB)\n");
+	} else if (p == NULL || (off & 3) || n == 0 || n > VVDEC_MAX_OPS || off + n * sizeof(struct vvdec_op) > gPoolSize) {
+		SAY("vdec: run OFF N [MS] (N <= %u ops)\n", VVDEC_MAX_OPS);
+	} else {
+		struct vvdec_op *ops = (struct vvdec_op *)((uint8_t *)gPool->getBytesNoCopy() + off);
+		uint32_t r[5];
+		gPool->performOperation(kIOMemoryIncoherentIOFlush, off, n * sizeof(struct vvdec_op));
+		runProgram(ops, (uint32_t)n, (uint32_t)ms, r);
+		gPool->performOperation(kIOMemoryIncoherentIOFlush, off, n * sizeof(struct vvdec_op));
+		SAY("vdec: run %llu ops status %u op %u irq 0x%08x hw %u us total %u us\n", n, r[0], r[1], r[2], r[3], r[4]);
+	}
+#undef SAY
+	*po = o;
+}

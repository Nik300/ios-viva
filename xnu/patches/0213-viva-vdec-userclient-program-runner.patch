+/* ---------------------------------------------------------------------------------------------- the service (0213) */
+
+class VivaVDEC : public IOService {
+	OSDeclareDefaultStructors(VivaVDEC);
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn newUserClient(task_t owningTask, void *securityID, UInt32 type, IOUserClient **handler) APPLE_KEXT_OVERRIDE;
+};
+
+class VivaVDECUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(VivaVDECUserClient);
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	virtual void free(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientMemoryForType(UInt32 type, IOOptionBits *options, IOMemoryDescriptor **memory) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+private:
+	IOReturn power(bool on);
+	IOReturn arena(uint64_t size, uint64_t out[2]);
+	void release_resources(void);
+	IOBufferMemoryDescriptor *fArena, *fProg;
+	uint64_t fArenaPA, fArenaSize;
+	bool fPoolArena, fPowered;
+};
+
+OSDefineMetaClassAndStructors(VivaVDEC, IOService);
+OSDefineMetaClassAndStructors(VivaVDECUserClient, IOUserClient);
+
+bool
+VivaVDEC::start(IOService *provider)
+{
+	if (!maps() || !IOService::start(provider)) {
+		return false;
+	}
+	setProperty("IOUserClientClass", "VivaVDECUserClient");
+	setProperty("VivaVDECUAPIVersion", (unsigned long long)VVDEC_UAPI_VERSION, 32);
+	registerService();
+	IOLog("VIVA VDEC: service published (pool %u MiB)\n", gPoolSize >> 20);
+	return true;
+}
+
+IOReturn
+VivaVDEC::newUserClient(task_t owningTask, void *securityID, UInt32 type, IOUserClient **handler)
+{
+	if (type != VVDEC_CLIENT_TYPE) {
+		return kIOReturnUnsupported;
+	}
+	/* larb4 bypasses the M4U: a program can make the VDEC write anywhere in RAM. Root or entitled tasks only. */
+	bool ok = IOUserClient::clientHasPrivilege(securityID, kIOClientPrivilegeAdministrator) == kIOReturnSuccess;
+	if (!ok) {
+		OSObject *e = IOUserClient::copyClientEntitlement(owningTask, VVDEC_ENTITLEMENT);
+		ok = e == kOSBooleanTrue;
+		OSSafeReleaseNULL(e);
+	}
+	if (!ok) {
+		return kIOReturnNotPrivileged;
+	}
+	VivaVDECUserClient *c = OSTypeAlloc(VivaVDECUserClient);
+	if (c == NULL) {
+		return kIOReturnNoMemory;
+	}
+	if (!c->initWithTask(owningTask, securityID, type) || !c->attach(this) || !c->start(this)) {
+		c->detach(this);
+		c->release();
+		return kIOReturnError;
+	}
+	*handler = c;
+	return kIOReturnSuccess;
+}
+
+bool
+VivaVDECUserClient::start(IOService *provider)
+{
+	if (OSDynamicCast(VivaVDEC, provider) == NULL || !IOUserClient::start(provider)) {
+		return false;
+	}
+	fProg = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task, kIODirectionInOut | kIOMemoryKernelUserShared,
+	    VVDEC_MAX_OPS * sizeof(struct vvdec_op), PAGE_SIZE);
+	if (fProg == NULL) {
+		return false;
+	}
+	IOLockLock(gLock);
+	gClients++;
+	IOLockUnlock(gLock);
+	return true;
+}
+
+/* Caller holds gLock. */
+IOReturn
+VivaVDECUserClient::power(bool on)
+{
+	if (on == fPowered) {
+		return kIOReturnSuccess;
+	}
+	if (on) {
+		const char *err = powerOn();
+		if (err != NULL) {
+			IOLog("VIVA VDEC: power on: %s\n", err);
+			return kIOReturnNotResponding;
+		}
+		gClientsPowered++;
+	} else if (--gClientsPowered == 0) {
+		const char *err = powerOff();
+		if (err != NULL) {
+			IOLog("VIVA VDEC: power off: %s\n", err);
+		}
+	}
+	fPowered = on;
+	return kIOReturnSuccess;
+}
+
+/* Caller holds gLock. The boot pool when it is free and big enough, else a new contiguous buffer below 4 GiB. */
+IOReturn
+VivaVDECUserClient::arena(uint64_t size, uint64_t out[2])
+{
+	if (fArena != NULL) {
+		return kIOReturnExclusiveAccess;
+	}
+	size = (size + PAGE_MASK) & ~(uint64_t)PAGE_MASK;
+	if (size == 0 || size > (256ull << 20)) {
+		return kIOReturnBadArgument;
+	}
+	if (gPool != NULL && !gPoolOwned && size <= gPoolSize) {
+		gPool->retain();
+		fArena = gPool;
+		fArenaPA = gPoolPA;
+		fArenaSize = gPoolSize;
+		fPoolArena = gPoolOwned = true;
+	} else {
+		fArena = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+		    kIODirectionInOut | kIOMemoryPhysicallyContiguous | kIOMemoryKernelUserShared, size, 0x00000000fffff000ull);
+		if (fArena == NULL) {
+			return kIOReturnNoMemory;
+		}
+		IOByteCount len = 0;
+		fArenaPA = fArena->getPhysicalSegment(0, &len, kIOMemoryMapperNone);
+		fArenaSize = size;
+		if (fArenaPA == 0 || len < size) {
+			OSSafeReleaseNULL(fArena);
+			return kIOReturnNoMemory;
+		}
+		bzero(fArena->getBytesNoCopy(), size);
+		fArena->performOperation(kIOMemoryIncoherentIOFlush, 0, size);
+	}
+	out[0] = fArenaPA;
+	out[1] = fArenaSize;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+VivaVDECUserClient::clientMemoryForType(UInt32 type, IOOptionBits *options, IOMemoryDescriptor **memory)
+{
+	IOMemoryDescriptor *md = type == VVDEC_MAP_ARENA ? fArena : type == VVDEC_MAP_PROGRAM ? fProg : NULL;
+	if (md == NULL) {
+		return kIOReturnBadArgument;
+	}
+	md->retain();
+	*memory = md;
+	*options = 0;
+	return kIOReturnSuccess;
+}
+
+void
+VivaVDECUserClient::release_resources(void)
+{
+	IOLockLock(gLock);
+	power(false);
+	if (fArena != NULL && fPoolArena) {
+		gPoolOwned = false;
+	}
+	OSSafeReleaseNULL(fArena);
+	fPoolArena = false;
+	IOLockUnlock(gLock);
+}
+
+IOReturn
+VivaVDECUserClient::clientClose(void)
+{
+	release_resources();
+	terminate();
+	return kIOReturnSuccess;
+}
+
+void
+VivaVDECUserClient::free(void)
+{
+	if (gLock != NULL && (fArena != NULL || fPowered)) {
+		release_resources();
+	}
+	if (fProg != NULL) {
+		IOLockLock(gLock);
+		gClients--;
+		IOLockUnlock(gLock);
+	}
+	OSSafeReleaseNULL(fProg);
+	IOUserClient::free();
+}
+
+IOReturn
+VivaVDECUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *a,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target, __unused void *reference)
+{
+	static const struct { uint32_t in, out; } shape[] = { { 0, 4 }, { 1, 0 }, { 1, 2 }, { 2, 0 }, { 2, 5 } };
+	if (selector >= sizeof(shape) / sizeof(shape[0]) || a->scalarInputCount != shape[selector].in ||
+	    a->scalarOutputCount < shape[selector].out) {
+		return kIOReturnBadArgument;
+	}
+	a->scalarOutputCount = shape[selector].out;
+	IOReturn ret = kIOReturnSuccess;
+	IOLockLock(gLock);
+	switch (selector) {
+	case VVDEC_SEL_INFO:
+		a->scalarOutput[0] = VVDEC_UAPI_VERSION;
+		a->scalarOutput[1] = vdePowered();
+		a->scalarOutput[2] = gPoolPA;
+		a->scalarOutput[3] = gPoolSize;
+		break;
+	case VVDEC_SEL_POWER:
+		ret = power(a->scalarInput[0] != 0);
+		break;
+	case VVDEC_SEL_ARENA:
+		ret = arena(a->scalarInput[0], a->scalarOutput);
+		break;
+	case VVDEC_SEL_SYNC: {
+		uint64_t off = a->scalarInput[0], len = a->scalarInput[1];
+		if (fArena == NULL || off > fArenaSize || len > fArenaSize - off) {
+			ret = kIOReturnBadArgument;
+		} else if (len != 0) {
+			fArena->performOperation(kIOMemoryIncoherentIOFlush, off, len);
+		}
+		break;
+	}
+	case VVDEC_SEL_RUN: {
+		uint64_t n = a->scalarInput[0];
+		uint32_t r[5];
+		if (n == 0 || n > VVDEC_MAX_OPS) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		runProgram((struct vvdec_op *)fProg->getBytesNoCopy(), (uint32_t)n, (uint32_t)a->scalarInput[1], r);
+		for (int i = 0; i < 5; i++) {
+			a->scalarOutput[i] = r[i];
+		}
+		break;
+	}
+	}
+	IOLockUnlock(gLock);
+	return ret;
+}
+
 #endif /* SWEET */

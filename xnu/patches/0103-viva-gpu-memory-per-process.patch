+/* Gated. */
+void
+VivaGPUAccelerator::vmLink(VivaGPUVM *vm)
+{
+	vm->nextVM = fVMs;
+	fVMs = vm;
+}
+
+/*
+ * Gated. Limits: all GPU memory (vivagpumemtotal, MiB, default 2048) and per process, summed over its connections
+ * (vivagpumem, MiB, default 1024). Refusals end as kIOReturnNoMemory for CREATE_BO, a failed map, or a heap that
+ * cannot grow (the chain fails), never a panic.
+ */
 bool
-VivaGPUAccelerator::chargeMemory(int64_t bytes)
+VivaGPUAccelerator::chargeMemory(VivaGPUVM *vm, int64_t bytes)
 {
-	if (bytes > 0 && fMemory + bytes > GPU_MEMORY_LIMIT) {
-		return false;
+	if (bytes > 0) {
+		int64_t proc = 0;
+		for (VivaGPUVM *v = fVMs; v != NULL; v = v->nextVM) {
+			if (v->pid == vm->pid) {
+				proc += v->bytes;
+			}
+		}
+		if (fMemory + bytes > fMemLimit || proc + bytes > fProcLimit) {
+			if (fMemRefused++ < 16) {
+				IOLog("VIVA GPU: %s[%d] out of GPU memory: +%lld KiB refused (process %lld/%lld MiB, all %lld/%lld "
+				    "MiB)\n", vm->proc, vm->pid, bytes >> 10, proc >> 20, fProcLimit >> 20, fMemory >> 20,
+				    fMemLimit >> 20);
+			}
+			return false;
+		}
 	}
 	fMemory += bytes;
+	vm->bytes += bytes;
+	if (fMemory > fMemPeak) {
+		fMemPeak = fMemory;
+	}
 	return true;
 }
 
+/* GPU memory per process (connections of one pid summed). */
+void
+VivaGPUAccelerator::memoryDump(char **out, char *end)
+{
+	say(out, end, "memory: %lld KiB (peak %lld KiB, limit %lld MiB, %lld MiB per process), %llu refusals\n",
+	    fMemory >> 10, fMemPeak >> 10, fMemLimit >> 20, fProcLimit >> 20, fMemRefused);
+	for (VivaGPUVM *v = fVMs; v != NULL; v = v->nextVM) {
+		bool seen = false;
+		for (VivaGPUVM *w = fVMs; w != v; w = w->nextVM) {
+			seen = seen || w->pid == v->pid;
+		}
+		if (seen) {
+			continue;
+		}
+		int64_t bytes = 0, imported = 0;
+		uint32_t conns = 0, bos = 0, faults = 0;
+		for (VivaGPUVM *w = v; w != NULL; w = w->nextVM) {
+			if (w->pid == v->pid) {
+				bytes += w->bytes;
+				imported += w->imported;
+				bos += w->bos;
+				faults += w->faults;
+				conns++;
+			}
+		}
+		say(out, end, "  %s[%d]: %lld KiB in %u BOs, %lld KiB imported, %u connection%s, %u MMU faults\n", v->proc,
+		    v->pid, bytes >> 10, bos, imported >> 10, conns, conns == 1 ? "" : "s", faults);
+	}
+}

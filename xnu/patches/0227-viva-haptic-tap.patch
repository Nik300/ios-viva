+/* 0227: wave 2 once (it ends and brakes by itself): a crisp tap. */
+void
+VivaHaptic::tapGated(uint8_t gain)
+{
+	if (!fRamOk) {
+		driveGated(gain);
+		return;
+	}
+	if (fPlaying) {
+		wr(AW_REG_PLAYCFG4, 0x02);
+		fPlaying = false;
+	}
+	bits(AW_REG_PLAYCFG3, (uint8_t)~7, 1 << 2);
+	wr(AW_REG_WAVCFG1, 2);
+	wr(AW_REG_WAVCFG2, 0);
+	bits(AW_REG_WAVCFG9, (uint8_t)~0xf0, 0);       /* slot 1 plays once */
+	wr(AW_REG_PLAYCFG2, gain);
+	wr(AW_REG_PLAYCFG4, 0x01);
+	fPlays++;
+	fTaps++;
+}

diff --git a/bsd/dev/viva_wifi.c b/bsd/dev/viva_wifi.c
index 74f77a6..d63984e 100644
--- a/bsd/dev/viva_wifi.c
+++ b/bsd/dev/viva_wifi.c
@@ -71,6 +71,7 @@ extern void *viva_wifi_emi_alloc(uint32_t size, uint64_t *pa);
 extern void viva_wifi_emi_flush(uint32_t offset, uint32_t len);
 extern void *viva_wifi_dma_alloc(uint32_t size, uint64_t *pa);
 extern void viva_wifi_dma_flush(uint32_t offset, uint32_t len);
+extern void *viva_wifi_dma_uncached(void);
 
 #define WIFI_FW_DIR             "/usr/share/firmware/wifi/viva/"
 #define EMI_SIZE                0x500000
@@ -161,7 +162,7 @@ extern void viva_wifi_dma_flush(uint32_t offset, uint32_t len);
 #define WF_READY                0x180c1140      /* (v & 0x6) == 0x6: WiFi firmware ready */
 
 static inline uint32_t rd(uint64_t pa) { return ml_phys_read_word_64(pa); }
-static inline void wr(uint64_t pa, uint32_t v) { ml_phys_write_word_64(pa, v); }
+static inline void wr(uint64_t pa, uint32_t v) { __builtin_arm_dsb(0xf); ml_phys_write_word_64(pa, v); }   /* WC descriptors first */
 static inline void rmw(uint64_t pa, uint32_t mask, uint32_t val) { wr(pa, (rd(pa) & ~mask) | (val & mask)); }
 
 static bool
@@ -922,21 +923,29 @@ wifi_wmt(char *out, size_t len, size_t o)
 
 static struct {
 	uint8_t *va;
+	uint8_t *uva;                   /* the same memory mapped write-combined (uncached): the descriptors */
 	uint64_t pa;
 	uint32_t txIdx[16], rxIdx[2];
 	uint8_t  seq;
 } wd;
 
+/*
+ * Ring descriptors are 16 bytes, four to a cache line: written through a cached mapping, cleaning the line of entry i
+ * also wrote back the CPU's stale copy of entries i+1..i+3 over what the DMA had just put there (DMA done + length),
+ * and the RX ring stopped for good at that entry (0151: WiFi data stalled after the first packets). Descriptors are
+ * only ever touched through the uncached mapping; the flushes of their (never dirtied) cached lines are harmless.
+ */
 static uint32_t *
 desc(uint32_t off, uint32_t i)
 {
-	return (uint32_t *)(void *)(wd.va + off + 16 * i);
+	return (uint32_t *)(void *)(wd.uva + off + 16 * i);
 }
 
 static void
 wfdma_setup(void)
 {
 	bzero(wd.va, DMA_SIZE);
+	viva_wifi_dma_flush(0, DMA_SIZE);               /* before any descriptor goes in through wd.uva */
 	static const uint32_t tx[] = { 0, 1, 3, 15 };
 	for (unsigned r = 0; r < 2; r++) {
 		for (uint32_t i = 0; i < RING_N; i++) {
@@ -1098,7 +1107,8 @@ wifi_fw(char *out, size_t len, size_t o)
 		return o;
 	}
 	wd.va = viva_wifi_dma_alloc(DMA_SIZE, &wd.pa);
-	if (wd.va == NULL) {
+	wd.uva = viva_wifi_dma_uncached();
+	if (wd.va == NULL || wd.uva == NULL) {
 		say("fw: no DMA memory\n");
 		return o;
 	}
diff --git a/iokit/Kernel/arm/VivaWiFi.cpp b/iokit/Kernel/arm/VivaWiFi.cpp
index 2c61caf..2bcacf7 100644
--- a/iokit/Kernel/arm/VivaWiFi.cpp
+++ b/iokit/Kernel/arm/VivaWiFi.cpp
@@ -76,6 +76,19 @@ viva_wifi_reserve(void)
 	IOLog("VIVA WIFI: reserved EMI %s 0x%llx, DMA %s 0x%llx\n", e ? "at" : "FAILED", emi, d ? "at" : "FAILED", dma);
 }
 
+/* The DMA memory mapped write-combined (normal uncached), for the ring descriptors (viva_wifi.c desc()). */
+static IOMemoryMap *gVivaWiFiDMAUncached;
+
+extern "C" void *
+viva_wifi_dma_uncached(void)
+{
+	if (gVivaWiFiDMAUncached == NULL && gVivaWiFiDMA != NULL) {
+		gVivaWiFiDMAUncached = gVivaWiFiDMA->createMappingInTask(kernel_task, 0,
+		    kIOMapAnywhere | kIOMapWriteCombineCache, 0, 0);
+	}
+	return gVivaWiFiDMAUncached ? (void *)gVivaWiFiDMAUncached->getVirtualAddress() : NULL;
+}
+
 /* Clean + invalidate a range of the DMA memory (before the device reads it, and before the CPU reads its writes). */
 extern "C" void
 viva_wifi_dma_flush(uint32_t offset, uint32_t len)

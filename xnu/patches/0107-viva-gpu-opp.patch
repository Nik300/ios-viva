+/*
+ * Gated: switch the running GPU to another OPP (raising: voltage then clock; lowering: clock then voltage).
+ * Jobs keep running; while the PLL relocks the GPU runs from mainpll_d5 (218 MHz).
+ */
+IOReturn
+VivaGPUAccelerator::setOpp(uint32_t opp, char **out, char *end)
+{
+	if (opp >= OPP_COUNT) {
+		return kIOReturnBadArgument;
+	}
+	fOpp = opp;
+	if (!fPowered) {
+		say(out, end, "OPP %u MHz from the next power on\n", gVivaOpp[opp].khz / 1000);
+		return kIOReturnSuccess;
+	}
+	uint32_t tvg, tvs, vgEn, vg, vsEn, vs;
+	oppSels(opp, &tvg, &tvs);
+	bool up = gVivaOpp[opp].khz > gVivaOpp[fClockOpp].khz;
+	if (!up) {
+		mfgClock(opp, out, end);
+	}
+	bool ok = railsTo(tvg, tvs);
+	if (up) {
+		if (ok) {
+			mfgClock(opp, out, end);
+		} else {
+			say(out, end, "rails did not reach the OPP: clock left at %u MHz\n", gVivaOpp[fClockOpp].khz / 1000);
+		}
+	}
+	railsRead(&vgEn, &vg, &vsEn, &vs);
+	say(out, end, "OPP %u MHz: vgpu %u uV, vsram_gpu %u uV%s\n", gVivaOpp[fClockOpp].khz / 1000, UV(vg), UV(vs),
+	    ok ? "" : " (PMIC write refused or failed)");
+	return ok ? kIOReturnSuccess : kIOReturnError;
 }
 

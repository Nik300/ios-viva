+
+/*
+ * 0206: where does the wired memory go (phone freezes at ~200k wired pages, 2026-11-07/13/14)? Every live surface,
+ * grouped by the process that created it: count, bytes, bytes marked volatile (purgeable, never discarded here),
+ * bytes with no user client holding them (only kernel references: GPU fences, the display, leaks). `surf all` also
+ * lists each surface of 1 MiB or more. Lines "SURF ..." go to the log; the reply has the totals.
+ */
+extern "C" void
+sweet_surface_report(const char *arg, char *out, size_t len)
+{
+	struct agg {
+		char     name[20];
+		uint32_t count, orphans;
+		uint64_t bytes, volatileBytes, orphanBytes;
+	};
+	const uint32_t maxAgg = 48;
+	struct agg *a = (struct agg *)IOMallocZeroData(sizeof(struct agg) * maxAgg);
+	if (a == NULL) {
+		snprintf(out, len, "surf: no memory\n");
+		return;
+	}
+	bool all = arg != NULL && strncmp(arg, "all", 3) == 0;
+	uint32_t naggs = 0, total = 0;
+	uint64_t bytes = 0, vol = 0, orphan = 0, now = mach_absolute_time(), ns;
+	sweet_surface_init_lock();
+	IOLockLock(sweet_surface_lock);
+	for (uint32_t id = 1; id < SWEET_SURFACE_MAX_ID; id++) {
+		SweetSurface *s = sweet_surface_table[id];
+		if (s == NULL) {
+			continue;
+		}
+		const char *name = s->creator[0] ? s->creator : "(kernel)";
+		uint32_t i;
+		for (i = 0; i < naggs && strncmp(a[i].name, name, sizeof(a[i].name)) != 0; i++) {
+		}
+		if (i == naggs && naggs < maxAgg) {
+			strlcpy(a[naggs++].name, name, sizeof(a[0].name));
+		}
+		bool noUsers = sweet_surface_users[id] == 0;
+		if (i < naggs) {
+			a[i].count++;
+			a[i].bytes += s->allocSize;
+			a[i].volatileBytes += s->purgeable == 1 ? s->allocSize : 0;
+			a[i].orphans += noUsers;
+			a[i].orphanBytes += noUsers ? s->allocSize : 0;
+		}
+		total++;
+		bytes += s->allocSize;
+		vol += s->purgeable == 1 ? s->allocSize : 0;
+		orphan += noUsers ? s->allocSize : 0;
+		if (all && s->allocSize >= (1u << 20)) {
+			absolutetime_to_nanoseconds(now - s->created, &ns);
+			printf("SURF %u %ux%u fmt 0x%x %u KiB users %u retain %d purg %u age %llu s %s%s\n", id, s->width,
+			    s->height, s->pixelFormat, s->allocSize >> 10, sweet_surface_users[id], s->getRetainCount(),
+			    s->purgeable, ns / 1000000000ull, name, s->contig ? " contig" : "");
+		}
+	}
+	IOLockUnlock(sweet_surface_lock);
+	for (uint32_t i = 0; i < naggs; i++) {
+		printf("SURF by %-20s %4u surfaces %7llu KiB, volatile %7llu KiB\n", a[i].name, a[i].count,
+		    a[i].bytes >> 10, a[i].volatileBytes >> 10);
+	}
+	/* surfaces left the table when their last client let go; a kernel reference (display, GPU fence, mapping)
+	 * keeps one alive: live - in table objects, wired counter - table bytes */
+	snprintf(out, len, "surf: %u in table, %llu MiB, volatile %llu MiB; %d objects alive; buffer memory %llu MiB "
+	    "(%lld MiB outside the table); \"SURF\" lines in the log\n", total, bytes >> 20, vol >> 20,
+	    (int)sweet_surface_live, sweet_surface_wired >> 20, ((long long)sweet_surface_wired - (long long)bytes) >> 20);
+	(void)orphan;
+	IOFreeData(a, sizeof(struct agg) * maxAgg);
+}
 #endif /* SWEET */

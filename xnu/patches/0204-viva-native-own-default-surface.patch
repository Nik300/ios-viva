+/*
+ * 0204: in native mode the boot framebuffer has the display's size, and CoreAnimation used the default surface as one
+ * of its pages: it drew into LK's buffer while the panel showed it, so animations flickered with half-drawn frames
+ * (phone, 2026-11-14: swaps of surface 1, "copies" of 2 us). It now gets a contiguous surface of its own, scanned
+ * out like the others once the GPU is done. The iPhone X presentation keeps the boot framebuffer (never a page:
+ * different size). Boot-arg sweetfb_ownsurface=0: old behaviour.
+ */
+SweetSurface *
+AppleCLCD::defaultSurface(void)
+{
+	IOLockLock(fLock);
+	if (fDefault == NULL) {
+		uint32_t own = 1;
+		PE_parse_boot_argn("sweetfb_ownsurface", &own, sizeof(own));
+		if (own && fLogicalW == fWidth && fLogicalH == fHeight) {
+			fDefault = sweet_surface_create_display(fLogicalW, fLogicalH, SWEET_FB_FORMAT_BGRA);
+			IOLog("SWEET FB: default surface %u (own, %s)\n", fDefault ? fDefault->id : 0,
+			    fDefault ? "contiguous" : "no memory: boot framebuffer");
+		}
+		if (fDefault == NULL) {
+			fDefault = fSurface;
+			fDefault->retain();
+		}
+	}
+	SweetSurface *s = fDefault;
+	IOLockUnlock(fLock);
+	return s;
+}

+static IOBufferMemoryDescriptor *sweet_surface_pool_take(uint32_t size, int8_t *slot);
+
+/*
+ * 0204: a display-sized BGRA surface the kernel hands out as AppleCLCD's default surface in native mode: physically
+ * contiguous (pool first, then a fresh range below 4 GiB) so the panel can scan it out, cacheable like any client
+ * surface. NULL when no contiguous memory is left (the caller keeps the boot framebuffer).
+ */
+SweetSurface *
+sweet_surface_create_display(uint32_t width, uint32_t height, uint32_t pixelFormat)
+{
+	SweetSurface *s = sweet_surface_alloc();
+	if (s == NULL) {
+		return NULL;
+	}
+	s->width = width;
+	s->height = height;
+	s->bytesPerElement = 4;
+	s->elementWidth = s->elementHeight = 1;
+	s->bytesPerRow = (uint32_t)(((uint64_t)width * 4 + SWEET_SURFACE_ROW_ALIGN - 1) & ~(uint64_t)(SWEET_SURFACE_ROW_ALIGN - 1));
+	s->pixelFormat = pixelFormat;
+	s->allocSize = (uint32_t)round_page((uint64_t)s->bytesPerRow * height);
+	IOBufferMemoryDescriptor *mem = sweet_surface_pool_take(s->allocSize, &s->poolSlot);
+	if (mem != NULL) {
+		sweet_surface_from_pool++;
+	} else if (sweet_surface_contig + s->allocSize <= SWEET_SURFACE_CONTIG_MAX) {
+		mem = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task, kIODirectionInOut |
+		    kIOMemoryKernelUserShared | kIOMemoryPhysicallyContiguous, s->allocSize, 0x00000000ffffc000ull);
+		if (mem != NULL) {
+			OSAddAtomic64(s->allocSize, (volatile SInt64 *)&sweet_surface_contig);
+			sweet_surface_from_contig++;
+		}
+	}
+	if (mem == NULL) {
+		s->release();
+		return NULL;
+	}
+	OSAddAtomic64(s->allocSize, (volatile SInt64 *)&sweet_surface_wired);
+	bzero(mem->getBytesNoCopy(), s->allocSize);
+	s->memory = mem;
+	s->contig = true;
+	s->cpuDirty = 1;
+	s->mapCache = kIOMapDefaultCache;
+	if (!sweet_surface_publish(s)) {
+		s->release();
+		return NULL;
+	}
+	return s;
+}

+/*
+ * 0203: sweetfb_native=1 is the one switch for the native 360x800 pt display (gpu/docs/PIANO-DISPLAY-NATIVO.md
+ * section 8): the device tree that userland reads is made to agree with the size AppleCLCD reports, before anything
+ * in userland starts. IOMobileFramebuffer takes the canvas from /arm-io/disp0; MobileGestalt takes the artwork
+ * subtype (2556 = the Dynamic Island devices) and DeviceCornerRadius (u32 numerator, u32 denominator, points) from
+ * /product. Without the switch the ADT's iPhone X values stay. Boot-args sweetfb_corner=PX (110, measured on the
+ * phone 2026-11-13) and sweetfb_subtype=N (2556). MobileGestalt caches all this: its cache must be rebuilt.
+ */
+static void
+sweet_fb_dt_u32s(const char *path, const char *key, const uint32_t *v, unsigned n)
+{
+	IORegistryEntry *e = IORegistryEntry::fromPath(path, gIODTPlane);
+	if (e == NULL) {
+		IOLog("SWEET FB: native: no %s in the device tree\n", path);
+		return;
+	}
+	OSData *d = OSData::withBytes(v, n * (unsigned)sizeof(uint32_t));
+	if (d != NULL) {
+		e->setProperty(key, d);
+		d->release();
+	}
+	e->release();
+}
+
+static void
+sweet_fb_native_dt(uint32_t w, uint32_t h)
+{
+	uint32_t corner = 110, subtype = 2556;
+	PE_parse_boot_argn("sweetfb_corner", &corner, sizeof(corner));
+	PE_parse_boot_argn("sweetfb_subtype", &subtype, sizeof(subtype));
+	uint32_t radius[2] = { corner, 3 };     /* px / scale = points */
+	sweet_fb_dt_u32s("/arm-io/disp0", "canvas-width", &w, 1);
+	sweet_fb_dt_u32s("/arm-io/disp0", "canvas-height", &h, 1);
+	sweet_fb_dt_u32s("/product", "artwork-device-subtype", &subtype, 1);
+	sweet_fb_dt_u32s("/product", "display-corner-radius", radius, 2);
+	IOLog("SWEET FB: native %ux%u: disp0 canvas, /product artwork-device-subtype %u, display-corner-radius %u/3 pt\n",
+	    w, h, subtype, corner);
+}
+
 bool

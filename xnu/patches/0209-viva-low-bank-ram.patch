+++ b/osfmk/arm/pmap/pmap.c
@@ -2204,7 +2204,22 @@ pmap_bootstrap(
 
 	memset((char *)phystokv(pmap_struct_start), 0, avail_start - pmap_struct_start);
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	extern pmap_paddr_t viva_lowmem_base;   /* arm_vm_init.c (0209): the low bank is managed memory too */
+	extern bool viva_lowmem_contains(pmap_paddr_t pa);
+	vm_first_phys = viva_lowmem_base;
+	/*
+	 * The carve-outs between the pieces are now inside [vm_first_phys, vm_last_phys) (pa_valid): keep them I/O by

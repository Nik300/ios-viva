+	 */
+	for (pmap_paddr_t pa = vm_first_phys; pa < gPhysBase; pa += PAGE_SIZE) {
+		if (!viva_lowmem_contains(pa)) {
+			pp_attr_table[atop(pa - vm_first_phys)] = (pp_attr_t)VM_WIMG_IO;
+		}
+	}
+#else

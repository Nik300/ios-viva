--- a/osfmk/arm64/caches_asm.s
+++ b/osfmk/arm64/caches_asm.s
@@ -468,6 +468,19 @@ LEXT(invalidate_icache64)
 LEXT(invalidate_icache)
 	cmp     w2, #0								// Is it physical?
 	b.eq	Lcall_invalidate_worker
+#if defined(SWEET)
+	/* 0209: low-bank pages sit below gPhysBase, outside the gVirtBase math: ask phystokv */

diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 56794af..ca5db59 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -362,8 +362,96 @@ typedef struct {
 	vm_size_t len;
 } ptov_table_entry;
 
+#if defined(SWEET)
+#define PTOV_TABLE_SIZE 32      /* 0209: one entry per low-bank piece too */
+#else
 #define PTOV_TABLE_SIZE 8
+#endif
 SECURITY_READ_ONLY_LATE(static ptov_table_entry)        ptov_table[PTOV_TABLE_SIZE];
+
+#if defined(SWEET)
+/*
+ * 0209: the RAM between the SoC's carve-outs. Kernel-managed memory starts above them (gPhysBase 0xc0000000 on viva),
+ * so the low bank (0x40000000-0xc0000000, 2 GiB less ~470 MiB of TEE, ATF, modem, SCP/SSPM, framebuffer...) was
+ * never used. The Mac (mkadt.py) lists the free pieces in /chosen "viva-lowmem" (<base size> u64 pairs, 16 KiB
+ * aligned, sorted, below gPhysBase). They get a physmap mapping of their own (the carve-outs between them are never
+ * mapped, so nothing prefetches TrustZone memory), pmap's per-page tables are extended down to the first piece
+ * (vm_first_phys = viva_lowmem_base: managed, cacheable pages, not I/O) and arm_vm_prot_finalize hands them to the VM
+ * with ml_static_mfree, as the memory below the kernel. gPhysBase, gVirtBase and the early mappings do not change.
+ * Boot-arg vivalowmem=0: off.
+ */
+#define VIVA_LOWMEM_MAX 24
+static struct {
+	pmap_paddr_t pa;
+	vm_size_t    len;
+} viva_lowmem[VIVA_LOWMEM_MAX];
+static unsigned int viva_lowmem_count;
+static vm_size_t viva_lowmem_total;
+SECURITY_READ_ONLY_LATE(pmap_paddr_t) viva_lowmem_base;        /* lowest kernel-managed PA (gPhysBase without pieces) */
+
+static void
+viva_lowmem_init(void)
+{
+	DTEntry chosen;
+	void const *prop;
+	unsigned int size;
+	uint32_t on = 1;
+
+	viva_lowmem_base = gPhysBase;
+	PE_parse_boot_argn("vivalowmem", &on, sizeof(on));
+	if (!on || SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, "viva-lowmem", &prop, &size) != kSuccess || size == 0 || (size % 16) != 0) {
+		return;
+	}
+	const uint64_t *r = (const uint64_t *)prop;
+	pmap_paddr_t last = 0;
+	for (unsigned int i = 0; i < size / 16; i++) {
+		pmap_paddr_t pa = r[2 * i];
+		uint64_t len = r[2 * i + 1];
+		if (viva_lowmem_count == VIVA_LOWMEM_MAX || (pa & PAGE_MASK) || (len & PAGE_MASK) || len == 0 || pa < last ||
+		    pa + len < pa || pa + len > gPhysBase) {
+			viva_lowmem_count = 0;          /* a bad list: none of it */
+			viva_lowmem_total = 0;
+			return;
+		}
+		viva_lowmem[viva_lowmem_count].pa = pa;
+		viva_lowmem[viva_lowmem_count].len = len;
+		viva_lowmem_count++;
+		viva_lowmem_total += len;
+		last = pa + len;
+	}
+	viva_lowmem_base = viva_lowmem[0].pa;
+}
+
+/* In a low-bank piece (pmap.c: the other pages below gPhysBase are carve-outs, I/O by default as before 0209). */
+bool
+viva_lowmem_contains(pmap_paddr_t pa)
+{
+	for (unsigned int i = 0; i < viva_lowmem_count; i++) {
+		if (pa >= viva_lowmem[i].pa && pa - viva_lowmem[i].pa < viva_lowmem[i].len) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* Physmap VA the pieces take: their length, plus up to a twig each for block alignment (arm_vm_physmap_slide). */
+static vm_size_t
+viva_lowmem_extra(void)
+{
+	return viva_lowmem_total + viva_lowmem_count * ARM_TT_TWIG_SIZE;
+}
+
+/* A PA the physmap may map: kernel-managed memory or a low-bank piece. */
+static bool
+viva_pa_mappable(pmap_paddr_t pa)
+{
+	if (pa >= gPhysBase) {
+		return pa < real_avail_end;
+	}
+	return viva_lowmem_contains(pa);
+}
+#endif /* SWEET */
 SECURITY_READ_ONLY_LATE(static boolean_t)               kva_active = FALSE;
 
 
@@ -1026,7 +1114,11 @@ arm_vm_page_granular_helper(vm_offset_t start, vm_offset_t _end, vm_offset_t va,
 		if ((pa + len) > real_avail_end) {
 			_end -= (pa + len - real_avail_end);
 		}
+#if defined(SWEET)
+		assert(viva_pa_mappable(start - gVirtBase + gPhysBase - pa_offset));
+#else
 		assert((start - gVirtBase + gPhysBase - pa_offset) >= gPhysBase);
+#endif
 
 		/* Round up to the nearest PAGE_SIZE boundary when creating mappings:
 		 * PAGE_SIZE may be a multiple of ARM_PGBYTES, and we don't want to leave
@@ -1117,7 +1209,11 @@ arm_vm_page_granular_prot(vm_offset_t start, unsigned long size, pmap_paddr_t pa
 
 			tte2 = arm_kva_to_tte(align_start);
 
+#if defined(SWEET)
+			if (viva_pa_mappable(pa) && viva_pa_mappable(pa + ARM_TT_L2_SIZE - 1)) {
+#else
 			if ((pa >= gPhysBase) && (pa < real_avail_end)) {
+#endif
 				tmplate = (pa & ARM_TTE_BLOCK_L2_MASK) | ARM_TTE_TYPE_BLOCK
 				    | ARM_TTE_VALID | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_NX
 				    | ARM_TTE_BLOCK_AP(pte_prot_APX) | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY)
@@ -1603,6 +1699,14 @@ arm_vm_physmap_init(boot_args *args)
 	arm_vm_physmap_slide(temp_ptov_table, (args->topOfKernelData - gPhysBase + gVirtBase),
 	    real_avail_end - args->topOfKernelData, AP_RWNA, ARM64_GRANULE_ALLOW_BLOCK | ARM64_GRANULE_ALLOW_HINT); // rest of physmem
 
+#if defined(SWEET)
+	/* 0209: the low-bank pieces (VA math wraps below gVirtBase on purpose: arm_vm_physmap_slide gets pa back) */
+	for (unsigned int i = 0; i < viva_lowmem_count; i++) {
+		arm_vm_physmap_slide(temp_ptov_table, (vm_map_address_t)(viva_lowmem[i].pa - gPhysBase + gVirtBase),
+		    viva_lowmem[i].len, AP_RWNA, ARM64_GRANULE_ALLOW_BLOCK | ARM64_GRANULE_ALLOW_HINT);
+	}
+#endif
+
 	assert((temp_ptov_table[ptov_index - 1].va + temp_ptov_table[ptov_index - 1].len) <= physmap_end);
 
 	// Sort in descending order of segment length.  LUT traversal is linear, so largest (most likely used)
@@ -1635,6 +1739,27 @@ arm_vm_prot_finalize(boot_args * args __unused)
 
 	ml_static_mfree(phystokv(gPhysBase), segLOWEST - gVirtBase);
 
+#if defined(SWEET)
+	/*
+	 * 0209: the low bank between the carve-outs. Not ml_static_mfree: the physmap is below VM_MIN_KERNEL_ADDRESS
+	 * (ARM_LARGE_MEMORY), where it silently frees nothing; the pages are already mapped read-write there. They were
+	 * counted as wired at startup (max_mem includes them), as ml_static_mfree's pages are.
+	 */
+	if (viva_lowmem_count != 0) {
+		uint32_t freed = 0;
+		for (unsigned int i = 0; i < viva_lowmem_count; i++) {
+			vm_page_create((ppnum_t)atop(viva_lowmem[i].pa), (ppnum_t)atop(viva_lowmem[i].pa + viva_lowmem[i].len));
+			freed += (uint32_t)atop(viva_lowmem[i].len);
+		}
+		vm_page_lockspin_queues();
+		vm_page_wire_count -= freed;
+		vm_page_wire_count_initial -= freed;
+		vm_page_unlock_queues();
+		printf("VIVA LOWMEM: %u pieces, %lu MiB below 0x%llx given to the VM\n", viva_lowmem_count,
+		    (unsigned long)(viva_lowmem_total >> 20), (unsigned long long)gPhysBase);
+	}
+#endif
+
 	/*
 	 * KTRR support means we will be mucking with these pages and trying to
 	 * protect them; we cannot free the pages to the VM if we do this.
@@ -1869,6 +1994,9 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	 */
 	gVirtBase = args->virtBase;
 	gPhysBase = args->physBase;
+#if defined(SWEET)
+	viva_lowmem_init();
+#endif
 #if KASAN
 	real_phys_size = args->memSize + (shadow_ptop - shadow_pbase);
 #else
@@ -1898,7 +2026,11 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	}
 
 #if defined(ARM_LARGE_MEMORY)
-	unsigned long physmap_l1_entries = ((real_phys_size + ARM64_PHYSMAP_SLIDE_RANGE + ARM64_PHYSMAP_ALIGNMENT_PADDING) >> ARM_TT_L1_SHIFT) + 1;
+	unsigned long physmap_l1_entries = ((real_phys_size + ARM64_PHYSMAP_SLIDE_RANGE + ARM64_PHYSMAP_ALIGNMENT_PADDING
+#if defined(SWEET)
+	    + viva_lowmem_extra()               /* 0209 */
+#endif
+	    ) >> ARM_TT_L1_SHIFT) + 1;
 	physmap_base = VM_MIN_KERNEL_ADDRESS - (physmap_l1_entries << ARM_TT_L1_SHIFT);
 #else
 	physmap_base = phystokv(args->topOfKernelData);
@@ -1929,6 +2061,17 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 #endif // ARM_LARGE_MEMORY
 #endif
 
+#if defined(SWEET)
+	/*
+	 * 0209: the low-bank pieces follow in the physmap (SWEET is ARM_LARGE_MEMORY: an aperture of its own below
+	 * VM_MIN_KERNEL_ADDRESS, sized by physmap_l1_entries above).
+	 */
+	physmap_end += viva_lowmem_extra();
+#if !defined(ARM_LARGE_MEMORY)
+	static_memory_end += viva_lowmem_extra();
+#endif
+#endif
+
 #if KASAN && !defined(ARM_LARGE_MEMORY)
 	/* add the KASAN stolen memory to the physmap */
 	dynamic_memory_begin = static_memory_end + (shadow_ptop - shadow_pbase);
@@ -2251,6 +2394,13 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 
 	sane_size = mem_size - (avail_start - gPhysBase);
 	max_mem = mem_size;
+#if defined(SWEET)
+	/* 0209: the low bank counts as memory (hw.memsize, VM and jetsam sizing) */
+	sane_size += viva_lowmem_total;
+	max_mem += viva_lowmem_total;
+	mem_actual += viva_lowmem_total;
+	max_mem_actual += viva_lowmem_total;
+#endif
 	vm_kernel_slid_base = segLOWESTTEXT;
 	// vm_kernel_slide is set by arm_init()->arm_slide_rebase_and_sign_image()
 	vm_kernel_stext = segTEXTB;
diff --git a/osfmk/arm64/caches_asm.s b/osfmk/arm64/caches_asm.s

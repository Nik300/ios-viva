+bool
+VivaGPUAccelerator::boIdle(VivaGPUBO *bo)
+{
+	if (bo->busy != NULL && !bo->busy->signalled) {
+		return false;
+	}
+	return bo->kind != kVivaBOSurface || bo->surface == NULL || surfaceIdle(bo->surface, NULL);
+}

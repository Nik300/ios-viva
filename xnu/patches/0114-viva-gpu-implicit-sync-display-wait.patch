+bool
+VivaGPUAccelerator::surfaceIdle(SweetSurface *s, uint64_t *jobs)
+{
+	VivaGPUFence *f = OSDynamicCast(VivaGPUFence, s->gpuFence);
+	if (jobs != NULL) {
+		*jobs = s->gpuJobs;
+	}
+	return f == NULL || f->signalled;
+}

+static uint64_t
+nowMs(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_MSEC;
+}
+
+/* CPU cache maintenance for physical memory, by VA through the physical aperture (to PoC). */
+static void
+cacheRangePA(uint64_t pa, uint64_t len, int op)
+{
+	uint64_t end = pa + len;
+	for (uint64_t line = pa & ~63ull; line < end; line += 64) {
+		uintptr_t va = (uintptr_t)phystokv(line);
+		if (op == kVivaCacheFlush) {
+			__asm__ volatile ("dc civac, %0" : : "r"(va) : "memory");
+		} else if (op == kVivaCacheInvalidate) {
+			__asm__ volatile ("dc ivac, %0" : : "r"(va) : "memory");
+		} else {
+			__asm__ volatile ("dc cvac, %0" : : "r"(va) : "memory");
+		}
+	}
+	__asm__ volatile ("dsb sy" : : : "memory");
+}
+
+/* Clean page-table entries written through a cacheable kernel address (the GPU's table walk is not coherent). */
+static void
+cleanVA(const void *p, size_t len)
+{
+	uintptr_t end = (uintptr_t)p + len;
+	for (uintptr_t line = (uintptr_t)p & ~(uintptr_t)63; line < end; line += 64) {
+		__asm__ volatile ("dc cvac, %0" : : "r"(line) : "memory");
+	}
+}
+
+void
+cacheRangeMD(IOMemoryDescriptor *md, uint64_t offset, uint64_t len, int op)
+{
+	while (len > 0) {
+		IOByteCount seg = 0;
+		addr64_t pa = md->getPhysicalSegment(offset, &seg, kIOMemoryMapperNone);
+		if (pa == 0 || seg == 0) {
+			return;
+		}
+		seg = MIN((uint64_t)seg, len);
+		cacheRangePA(pa, seg, op);
+		offset += seg;
+		len -= seg;
+	}
+}
+
+static const char *
+jsStatusName(uint32_t s)
+{
+	switch (s) {
+	case 0x01: return "done";
+	case 0x03: return "stopped";
+	case 0x04: return "terminated";
+	case 0x40: return "job config fault";
+	case 0x41: return "power fault";
+	case 0x42: return "job read fault";
+	case 0x43: return "job write fault";
+	case 0x44: return "affinity fault";
+	case 0x48: return "job bus fault";
+	case 0x50: return "instr invalid pc";
+	case 0x51: return "instr invalid enc";
+	case 0x58: return "data invalid fault";
+	case 0x59: return "tile range fault";
+	case 0x5a: return "address range fault";
+	case 0x60: return "out of memory";
+	case 0x80: return "delayed bus fault";
+	case 0x88: return "shareability fault";
+	default:
+		if ((s & 0xf8) == 0xc0) {
+			return "translation fault";
+		}
+		if ((s & 0xf8) == 0xc8) {
+			return "permission fault";
+		}
+		if ((s & 0xf8) == 0xd8) {
+			return "access flag fault";
+		}
+		return "?";
+	}
+}

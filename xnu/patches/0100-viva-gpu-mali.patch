+VivaGPUFence *
+VivaGPUFence::create(bool isSignalled)
+{
+	VivaGPUFence *f = new VivaGPUFence;
+	if (f != NULL && !f->init()) {
+		f->release();
+		return NULL;
+	}
+	if (f != NULL) {
+		f->signalled = isSignalled;
+		f->error = kIOReturnSuccess;
+	}
+	return f;
+}

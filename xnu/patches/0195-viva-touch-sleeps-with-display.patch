+/* 0195: from the display's power path (any context that may block briefly; never waits for the IC). */
+void
+VivaGT9896::displayPower(bool on)
+{
+	fWantAsleep = !on;
+	thread_call_enter(fSleepCall);
+}
+
+void
+VivaGT9896::sleepCall(thread_call_param_t p0, thread_call_param_t p1 __unused)
+{
+	VivaGT9896 *self = (VivaGT9896 *)p0;
+	self->fWorkLoop->runAction(&VivaGT9896::sleepAction, self);
+}
+
+IOReturn
+VivaGT9896::sleepAction(OSObject *owner, void *a0 __unused, void *a1 __unused, void *a2 __unused, void *a3 __unused)
+{
+	VivaGT9896 *self = OSDynamicCast(VivaGT9896, owner);
+	if (self != NULL) {
+		self->setAsleep(self->fWantAsleep);     /* the latest request: a quick off/on pair settles on "on" */
+	}
+	return kIOReturnSuccess;
 }
 
+/* On the work loop (gate held: no interrupt handler runs meanwhile). */
 void
+VivaGT9896::setAsleep(bool asleep)
+{
+	if (asleep == fAsleep) {
+		return;
+	}
+	if (asleep) {
+		fInterrupt->disable();
+		for (uint32_t id = 0; id < SWEET_TOUCH_FINGERS; id++) {
+			if (fPrevMap & (1u << id)) {
+				touch((int)id, false, 0, 0);    /* nothing stays down while the screen is off */
+			}
+		}
+		fPrevMap = 0;
+		uint8_t zero = 0;
+		writeReg(fRegCoor, &zero, 1);
+		uint8_t cmd[5] = { GT_COMMAND_SLEEP, 0, 0, 0, GT_COMMAND_SLEEP };      /* goodix_cmd_init, Yellowstone */
+		IOReturn r = writeReg(fRegCommand, cmd, sizeof(cmd));
+		fAsleep = true;
+		fSleeps++;
+		if (r != kIOReturnSuccess) {
+			fSleepFails++;
+		}
+		if (fSleeps <= 4 || r != kIOReturnSuccess) {
+			IOLog("VIVA TOUCH: display off: interrupt off, IC sleep %s (%u events so far)\n",
+			    r == kIOReturnSuccess ? "sent" : "NOT sent", fEvents);
+		}
+		return;
+	}
+	/* goodix_hw_resume = goodix_hw_reset: reset low, high, then the IC's own start-up time */
+	fGPIO->setOutput(fReset, false);
+	IODelay(2000);
+	fGPIO->setOutput(fReset, true);
+	IOSleep(110);
+	uint8_t zero = 0;
+	writeReg(fRegCoor, &zero, 1);
+	fAsleep = false;
+	fWakes++;
+	fInterrupt->enable();
+	if (fWakes <= 4) {
+		IOLog("VIVA TOUCH: display on: IC reset, interrupt on\n");
+	}
+}
+
+extern "C" void
+viva_touch_display_power(int on)
+{
+	if (gVivaTouch != NULL && gVivaTouchSleep) {
+		gVivaTouch->displayPower(on != 0);
+	}
+}

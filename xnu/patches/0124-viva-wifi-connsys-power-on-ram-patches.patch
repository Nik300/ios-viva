@@ -140,6 +173,11 @@ wifi_status(char *out, size_t len, size_t o)
 	    pmic(PMIC_VCN33_CON0_0), pmic(PMIC_VCN33_CON0_1), !!(pmic(PMIC_VCN33_CON1) & 0x8000), pmic(PMIC_VCN33_ANA),

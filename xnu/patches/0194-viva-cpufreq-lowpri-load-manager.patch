 #endif /* CONFIG_SCHED_EDGE */
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * viva 0194: time each CPU spends running low-priority threads (sched_pri <= viva_lowpri_max: background and
+ * maintenance QoS, MAXPRI_THROTTLE), for the CPU governor (osfmk/arm64/viva_cpufreq.c): work nobody waits for no
+ * longer drives a cluster to its fastest clock (PowerLog's SQLite thread at priority 4 held the A55s at 2 GHz).
+ * Updated on the CPU itself at every processor state change (context switch, idle); read racily by the governor.
+ */
+int viva_lowpri_max = MAXPRI_THROTTLE;
+uint64_t viva_lowpri_time[MAX_SCHED_CPUS];      /* accumulated mach time on low-priority threads */
+uint64_t viva_lowpri_since[MAX_SCHED_CPUS];     /* != 0: running one since then */
+
+static inline void
+viva_lowpri_switch(processor_t processor, bool low)
+{
+	int c = processor->cpu_id;
+	if (c < 0 || c >= MAX_SCHED_CPUS) {
+		return;
+	}
+	uint64_t since = viva_lowpri_since[c];
+	if ((since != 0) == low) {
+		return;
+	}
+	uint64_t now = mach_absolute_time();
+	if (since != 0) {
+		os_atomic_add(&viva_lowpri_time[c], now - since, relaxed);
+	}
+	os_atomic_store(&viva_lowpri_since[c], low ? now : 0, relaxed);
+}
 
+/* Low-priority time of CPU c up to now (the running stretch included). */
+uint64_t
+viva_lowpri_time_now(int c)
+{
+	if (c < 0 || c >= MAX_SCHED_CPUS) {
+		return 0;
+	}
+	uint64_t t = os_atomic_load(&viva_lowpri_time[c], relaxed);
+	uint64_t since = os_atomic_load(&viva_lowpri_since[c], relaxed);
+	uint64_t now = mach_absolute_time();
+	return t + (since != 0 && now > since ? now - since : 0);
+}
+#endif
+
 void
 processor_state_update_idle(processor_t processor)
 {
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	viva_lowpri_switch(processor, false);
+#endif
 	processor->current_pri = IDLEPRI;
 	processor->current_sfi_class = SFI_CLASS_KERNEL;
 	processor->current_recommended_pset_type = PSET_SMP;
@@ -446,6 +492,9 @@
 void
 processor_state_update_from_thread(processor_t processor, thread_t thread, boolean_t pset_lock_held)
 {
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	viva_lowpri_switch(processor, !(thread->state & TH_IDLE) && thread->sched_pri <= viva_lowpri_max);
+#endif
 	processor->current_pri = thread->sched_pri;
 	processor->current_sfi_class = thread->sfi_class;
 	processor->current_recommended_pset_type = recommended_pset_type(thread);
@@ -475,6 +524,9 @@
 processor_state_update_explicit(processor_t processor, int pri, sfi_class_id_t sfi_class,
     pset_cluster_type_t pset_type, perfcontrol_class_t perfctl_class, thread_urgency_t urgency, __unused sched_bucket_t bucket)
 {
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	viva_lowpri_switch(processor, pri > IDLEPRI && pri <= viva_lowpri_max);
+#endif
 	processor->current_pri = pri;
 	processor->current_sfi_class = sfi_class;
 	processor->current_recommended_pset_type = pset_type;

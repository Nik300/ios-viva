+/* aw8622x_container_update with a generated image: 3K SRAM, base/FIFO thresholds, the wave table, the samples. */
+void
+VivaHaptic::ramUpload(void)
+{
+	const uint32_t base = HAP_RAM_BASE, start = base + 5, end = start + sizeof(gHapSine) - 1;
+	bits(AW_REG_RTPCFG1, (uint8_t)~(3 << 4), 3 << 4);               /* 3K SRAM */
+	bits(AW_REG_RTPCFG1, (uint8_t)~0x0f, (uint8_t)(base >> 8));
+	wr(AW_REG_RTPCFG2, (uint8_t)base);
+	bits(AW_REG_RTPCFG3, (uint8_t)~0xf0, (uint8_t)(((base >> 1) >> 4) & 0xf0));
+	wr(AW_REG_RTPCFG4, (uint8_t)((base >> 1) & 0xff));
+	bits(AW_REG_RTPCFG3, (uint8_t)~0x0f, (uint8_t)(((base - (base >> 2)) >> 8) & 0x0f));
+	wr(AW_REG_RTPCFG5, (uint8_t)((base - (base >> 2)) & 0xff));
+	const uint8_t head[5] = { 0x55, (uint8_t)(start >> 8), (uint8_t)start, (uint8_t)(end >> 8), (uint8_t)end };
+	wr(AW_REG_RAMADDRH, (uint8_t)(base >> 8));
+	wr(AW_REG_RAMADDRL, (uint8_t)base);
+	for (unsigned i = 0; i < sizeof(head); i++) {
+		wr(AW_REG_RAMDATA, head[i]);
+	}
+	for (unsigned i = 0; i < sizeof(gHapSine); i++) {
+		wr(AW_REG_RAMDATA, gHapSine[i]);
+	}
+	/* read back */
+	wr(AW_REG_RAMADDRH, (uint8_t)(base >> 8));
+	wr(AW_REG_RAMADDRL, (uint8_t)base);
+	unsigned bad = 0;
+	for (unsigned i = 0; i < sizeof(head) + sizeof(gHapSine); i++) {
+		uint8_t v = 0;
+		rd(AW_REG_RAMDATA, &v);
+		bad += v != (i < sizeof(head) ? head[i] : gHapSine[i - sizeof(head)]);
+	}
+	fRamOk = bad == 0;
+	IOLog("VIVA HAPTIC: RAM waveform %lu samples at 0x%x: %s (%u bad)\n", sizeof(gHapSine), start,
+	    fRamOk ? "ok" : "FAILED, CONT mode", bad);
+}

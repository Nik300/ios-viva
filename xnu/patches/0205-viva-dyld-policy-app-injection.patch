index 68612db..dfbb18b 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -5541,6 +5541,46 @@ bad:
 }
 
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * 0205: global injection for viva's display fixes inside apps (gpu/docs/PIANO-DISPLAY-NATIVO.md section 9; the first
+ * one is the keyboard, laid out 20 pt off on the 360 pt screen). Executables inside an .app bundle (apps, their
+ * extensions, CoreServices apps such as Spotlight; not SpringBoard, which loads VivaIsland.dylib, nor daemons) get
+ * DYLD_INSERT_LIBRARIES=VivaUIKit.dylib unless they already have one; dyld honours it through the "AMFI" policy
+ * (bsd/kern/sweet_amfi.c), and a missing dylib is not fatal: deleting the file turns it off. Boot-arg vivainject=0: off.
+ */
+static const char viva_inject_env[] = "DYLD_INSERT_LIBRARIES=/var/jb/usr/lib/VivaUIKit.dylib";
+
+static bool
+viva_inject_wanted(struct image_params *imgp)
+{
+	static int inject = -1;
+	static uint32_t logged;
+	if (inject < 0) {
+		uint32_t v = 1;
+		PE_parse_boot_argn("vivainject", &v, sizeof(v));
+		inject = v != 0;
+	}
+	if (!inject || imgp->ip_vp == NULLVP) {
+		return false;
+	}
+	char *path = kalloc_data(MAXPATHLEN, Z_WAITOK);
+	int len = MAXPATHLEN;
+	bool want = false;
+	if (path != NULL && vn_getpath(imgp->ip_vp, path, &len) == 0) {
+		want = strnstr(path, ".app/", MAXPATHLEN) != NULL && strnstr(path, "/SpringBoard.app/", MAXPATHLEN) == NULL;
+		if (want && logged < 32) {
+			logged++;
+			printf("VIVA INJECT: %s\n", path);
+		}
+	}
+	if (path != NULL) {
+		kfree_data(path, MAXPATHLEN);
+	}
+	return want;
+}
+#endif

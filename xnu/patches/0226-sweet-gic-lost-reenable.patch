@@ -248,10 +250,49 @@ SweetGIC::handleInterrupt(void *refCon __unused, IOService *nub __unused, int so
 		vector->interruptDisabledHard = 1;
 		disableVectorHard(source, vector);
 	}
+	/*
+	 * 0226: interruptDisabledHard and the GICD write must be visible before interruptActive drops:
+	 * IOInterruptController::enableInterrupt on another core waits for interruptActive == 0 and then reads
+	 * interruptDisabledHard. Without this barrier it could see the 0 first, skip the re-enable, and leave the
+	 * line masked for good (2026-11-19: the GPU job interrupt, INTID 308, disabled + pending, every job
+	 * "timed out" while done).
+	 */
+	OSMemoryBarrier();
 	vector->interruptActive = 0;
 	return kIOReturnSuccess;
 }
 
+/*
+ * 0226: XNU's enableInterrupt re-enables the GIC line only if it read interruptDisabledHard set, and its loads
+ * after the interruptActive spin are not ordered on ARM. After it, if the vector is soft-enabled, the line is
+ * enabled again unconditionally (idempotent). A line found masked here although soft- and hard-enabled is the
+ * lost re-enable: counted and logged.
+ */
+IOReturn
+SweetGIC::enableInterrupt(IOService *nub, int source)
+{
+	IOReturn ret = IOInterruptController::enableInterrupt(nub, source);
+	uint32_t intid, flags;
+	if (ret != kIOReturnSuccess || !spec(nub, source, &intid, &flags) || intid < FIRST_SPI || intid >= fNumIntids) {
+		return ret;
+	}
+	IOInterruptVector *vector = &vectors[intid];
+	OSMemoryBarrier();
+	if (!vector->interruptDisabledSoft) {
+		bool masked = !(rd32(GICD_ISENABLER(intid)) & (1u << (intid % 32)));
+		if (masked && !vector->interruptDisabledHard && vector->interruptRegistered) {
+			if (fLostEnables++ < 20) {
+				IOLog("SWEET GIC: INTID %u was masked although enabled (lost re-enable %u), enabling\n", intid,
+				    fLostEnables);
+			}
+		}
+		vector->interruptDisabledHard = 0;
+		OSMemoryBarrier();
+		enableVector(intid, vector);
+	}
+	return ret;
+}

+static uint32_t
+hexval(char c)
+{
+	return c >= '0' && c <= '9' ? (uint32_t)(c - '0') : c >= 'a' && c <= 'f' ? (uint32_t)(c - 'a' + 10) :
+	       c >= 'A' && c <= 'F' ? (uint32_t)(c - 'A' + 10) : 16u;
+}
+
+static const char *
+num(const char *s, uint64_t *v)
+{
+	while (*s == ' ') {
+		s++;
+	}
+	const char *e = s;
+	*v = strtoq(s, (char **)&e, 0);
+	return e == s ? NULL : e;
+}
+
+/* Pool access for the Mac (rd / wr / zero / sum). Caller holds gLock. */
+static void
+poolCmd(const char *args, char *out, size_t len, size_t *po)
+{
+	size_t o = *po;
+#define SAY(...) do { if (o < len) o += (size_t)snprintf(out + o, len - o, __VA_ARGS__); } while (0)
+	uint64_t off = 0, n = 0, chunk = 0;
+	uint8_t *va = gPool != NULL ? (uint8_t *)gPool->getBytesNoCopy() : NULL;
+	const char *p = num(args + 3, &off);
+	if (va == NULL) {
+		SAY("vdec: no pool (boot-arg vivavdecpool=MB)\n");
+	} else if (p == NULL || off >= gPoolSize) {
+		SAY("vdec: bad offset\n");
+	} else if (strncmp(args, "rd", 2) == 0) {
+		if (num(p, &n) == NULL || n == 0 || n > 1536 || off + n > gPoolSize) {
+			SAY("vdec: rd OFF N (N <= 1536)\n");
+		} else {
+			gPool->performOperation(kIOMemoryIncoherentIOFlush, off, n);
+			SAY("vdec: rd 0x%llx ", off);
+			for (uint64_t i = 0; i < n; i++) {
+				SAY("%02x", va[off + i]);
+			}
+			SAY("\n");
+		}
+	} else if (strncmp(args, "wr", 2) == 0) {
+		while (*p == ' ') {
+			p++;
+		}
+		for (n = 0; hexval(p[0]) < 16 && hexval(p[1]) < 16 && off + n < gPoolSize; p += 2, n++) {
+			va[off + n] = (uint8_t)(hexval(p[0]) << 4 | hexval(p[1]));
+		}
+		if (n) {
+			gPool->performOperation(kIOMemoryIncoherentIOFlush, off, n);
+		}
+		SAY("vdec: wr 0x%llx %llu\n", off, n);
+	} else if (strncmp(args, "zero", 4) == 0) {
+		if (num(p, &n) == NULL || off + n > gPoolSize) {
+			SAY("vdec: zero OFF N\n");
+		} else {
+			bzero(va + off, n);
+			gPool->performOperation(kIOMemoryIncoherentIOFlush, off, n);
+			SAY("vdec: zero 0x%llx %llu\n", off, n);
+		}
+	} else {
+		const char *q = num(p, &n);
+		if (q == NULL || num(q, &chunk) == NULL || chunk == 0 || off + n > gPoolSize || n / chunk > 256) {
+			SAY("vdec: sum OFF N CHUNK (<= 256 chunks)\n");
+		} else {
+			gPool->performOperation(kIOMemoryIncoherentIOFlush, off, n);
+			SAY("vdec: sum 0x%llx", off);
+			for (uint64_t c = 0; c < n; c += chunk) {
+				uint32_t h = 2166136261u;
+				for (uint64_t i = c; i < c + chunk && i < n; i++) {
+					h = (h ^ va[off + i]) * 16777619u;
+				}
+				SAY(" %08x", h);
+			}
+			SAY("\n");
+		}
+	}
+#undef SAY
+	*po = o;
+}

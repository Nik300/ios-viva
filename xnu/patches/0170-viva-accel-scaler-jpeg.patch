diff --git a/iokit/Kernel/arm/VivaJPEG.h b/iokit/Kernel/arm/VivaJPEG.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/VivaJPEG.h
@@ -0,0 +1,34 @@
+/*
+ * viva (MT6781): hardware JPEG encoder (VivaJPEGHW.cpp) and the AppleJPEGDriver service on top of it
+ * (VivaJPEG.cpp). Encode only: MT6781 has no JPEG decoder, decode requests are refused so clients keep decoding in
+ * software.
+ *
+ * Boot-arg vivajpeg (Viva Manager, MaliMetal > Acceleratori): 0 (default) = not published, 1 = published.
+ */
+#ifndef _IOKIT_ARM_VIVAJPEG_H
+#define _IOKIT_ARM_VIVAJPEG_H
+
+#include <IOKit/IOReturn.h>
+#include <stddef.h>
+#include <stdint.h>
+
+enum { kVivaJpegNV12 = 1, kVivaJpegNV21 = 2, kVivaJpegYUYV = 3 };   /* YUYV: one plane, y = the packed pixels */
+
+struct viva_jpgenc_image {
+	uint32_t format;                /* kVivaJpegNV12 / NV21 */
+	uint32_t width, height;
+	const uint8_t *y, *uv;          /* kernel addresses of the planes */
+	uint32_t yBytesPerRow, uvBytesPerRow;
+};
+
+struct viva_jpgenc;
+
+/* Powers the block and allocates bounce buffers for images up to maxPixels; NULL if the hardware is unusable. */
+struct viva_jpgenc *viva_jpgenc_create(size_t maxPixels);
+void viva_jpgenc_destroy(struct viva_jpgenc *j);
+/* One encode (synchronous, polls the block): a complete JFIF file into out. quality 0..100. Not reentrant. */
+IOReturn viva_jpgenc_encode(struct viva_jpgenc *j, const struct viva_jpgenc_image *img, uint32_t quality, void *out,
+    size_t outCap, size_t *outLen, uint32_t *cycles);
+void viva_jpgenc_stats(struct viva_jpgenc *j, uint64_t *encodes, uint64_t *failures, uint64_t *bytes, uint64_t *cycles);
+
+#endif /* _IOKIT_ARM_VIVAJPEG_H */
diff --git a/iokit/Kernel/arm/VivaJPEGHW.cpp b/iokit/Kernel/arm/VivaJPEGHW.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/VivaJPEGHW.cpp
@@ -0,0 +1,383 @@
+/*
+ * viva (MT6781): the hardware JPEG encoder (jpgenc@17030000) driven with physical addresses (VivaJPEG.h).
+ *
+ * Sequence validated by hand on the phone over the USB link (2026-11-05, gpu/docs/JPGENC-MT6781.md): venc_sel
+ * mux = mainpll_d3, VEN MTCMOS on (SPM VEN_PWR_CON 0x10006348: PWR_ON, PWR_ON_2ND, status bit 18 in
+ * 0x1000616C/0x10006170, CLK_DIS/ISO off, RST_B, SRAM_PDN off, SRAM ack bit 12 -> 0x0000000D), bus protection
+ * released (infracfg 0x100012AC bits 19, 31), VENC_GCON 0x17000000 |= larb, venc, jpgenc, gals (1 = on), larb7
+ * outstanding limits 5/3/1/5 and ports 9-12 (Y, CbCr, Q table, bitstream) out of the M4U (physical addresses),
+ * reset, then one 256x256 NV12 at Q90: INT_STS = DONE after ~37k cycles, a complete JFIF file (FF D8 FF E0 ...)
+ * of DMA_ADDR0 - DST_ADDR0 bytes that decodes on the Mac.
+ *
+ * Every encode goes through two physically contiguous bounce buffers below 4 GiB (source NV12/NV21 with its
+ * stride and height padded to 16, destination bitstream): IOSurfaces and user buffers are not contiguous and the
+ * block has no IOMMU mapping. The block does not snoop the CPU caches: the source is cleaned to memory before the
+ * start, the destination dropped from the caches after DONE.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <kern/clock.h>
+#include <mach/mach_time.h>
+
+#include "VivaJPEG.h"
+
+#define PA_TOPCKGEN     0x10000000ull
+#define PA_INFRACFG     0x10001000ull
+#define PA_SPM          0x10006000ull
+#define PA_VENC_GCON    0x17000000ull
+#define PA_LARB7        0x17010000ull
+#define PA_JPGENC       0x17030000ull
+
+/* topckgen */
+#define CLK_CFG_UPDATE          0x008
+#define CLK_CFG_9               0x0d0   /* venc_sel [2:0], set +4 / clear +8 */
+#define CLK_CFG_9_SET           0x0d4
+#define CLK_CFG_9_CLR           0x0d8
+#define VENC_SEL_MAINPLL_D3     6
+#define VENC_SEL_UPDATE         (1u << 5)
+/* SPM */
+#define SPM_POWERON_CONFIG      0x000
+#define SPM_PROJECT_KEY         0x0b160001
+#define SPM_PWR_STATUS          0x16c
+#define SPM_PWR_STATUS_2ND      0x170
+#define SPM_VEN_PWR_CON         0x348
+#define PWR_RST_B               (1u << 0)
+#define PWR_ISO                 (1u << 1)
+#define PWR_ON                  (1u << 2)
+#define PWR_ON_2ND              (1u << 3)
+#define PWR_CLK_DIS             (1u << 4)
+#define SRAM_PDN                (1u << 8)
+#define SRAM_PDN_ACK            (1u << 12)
+#define VEN_STATUS_BIT          (1u << 18)
+/* infracfg_ao bus protection */
+#define INFRA_TOPAXI_PROTECTEN_CLR      0x2ac
+#define INFRA_TOPAXI_PROTECTEN_STA1     0x250
+#define VEN_PROT_STEP2          (1u << 19)
+#define VEN_PROT_STEP1          (1u << 31)
+/* VENC_GCON: 1 = clock on */
+#define VENC_CG                 0x000
+#define VENC_CG_ON              ((1u << 0) | (1u << 4) | (1u << 8) | (1u << 28))
+/* larb7 */
+#define LARB_OSTD(port)         (0x200 + 4 * (port))
+#define LARB_PORT_CTRL(port)    (0x380 + 4 * (port))
+#define LARB_PORT_MMU_BITS      0xff01u
+/* jpgenc */
+#define JE_RSTB                 0x100
+#define JE_CTRL                 0x104
+#define JE_QUALITY              0x108
+#define JE_BLK_NUM              0x10c
+#define JE_INT_STS              0x11c
+#define JE_DST_ADDR0            0x120
+#define JE_DMA_ADDR0            0x124
+#define JE_STALL_ADDR0          0x128
+#define JE_OFFSET_ADDR          0x138
+#define JE_RST_MCU_NUM          0x150
+#define JE_IMG_SIZE             0x154
+#define JE_TOTAL_CYCLE          0x168
+#define JE_BYTE_OFFSET_MASK     0x16c
+#define JE_SRC_LUMA_ADDR        0x170
+#define JE_SRC_CHROMA_ADDR      0x174
+#define JE_STRIDE               0x178
+#define JE_IMG_STRIDE           0x17c
+#define JE_CODEC_SEL            0x314
+#define JE_ULTRA_THRES          0x318
+#define JE_CTRL_ENABLE          (1u << 0)
+#define JE_CTRL_INT_EN          (1u << 2)
+#define JE_CTRL_FMT_SHIFT       3
+#define JE_CTRL_START_BITS      (JE_CTRL_ENABLE | JE_CTRL_INT_EN | (1u << 20) | (1u << 29))
+#define JE_INT_DONE             0x01
+#define JE_INT_STALL            0x02
+#define JE_INT_VCODEC           0x10
+
+#define JE_TIMEOUT_MS           500
+
+struct viva_jpgenc {
+	IOMemoryMap *topck, *infra, *spm, *gcon, *larb, *jpg;
+	IOBufferMemoryDescriptor *src, *dst;
+	uint64_t srcPA, dstPA;
+	size_t srcSize, dstSize;
+	bool powered;
+	uint64_t encodes, failures, bytesOut, cycles;
+};
+
+static inline volatile uint32_t *
+reg(IOMemoryMap *m, uint32_t off)
+{
+	return (volatile uint32_t *)(m->getVirtualAddress() + off);
+}
+static inline uint32_t rd(IOMemoryMap *m, uint32_t off) { return *reg(m, off); }
+static inline void wr(IOMemoryMap *m, uint32_t off, uint32_t v) { *reg(m, off) = v; __asm__ volatile ("dsb sy" ::: "memory"); }
+
+static IOMemoryMap *
+mapRegs(uint64_t pa, uint32_t size)
+{
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(pa, size, kIODirectionInOut);
+	IOMemoryMap *m = md != NULL ? md->map(kIOMapInhibitCache) : NULL;
+	OSSafeReleaseNULL(md);
+	return m;
+}
+
+static void
+cacheClean(const void *p, size_t len)
+{
+	uintptr_t a = (uintptr_t)p & ~(uintptr_t)63, end = (uintptr_t)p + len;
+	for (; a < end; a += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r"(a) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static IOBufferMemoryDescriptor *
+contiguous(size_t size, uint64_t *pa)
+{
+	IOBufferMemoryDescriptor *b = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+	    kIODirectionInOut | kIOMemoryPhysicallyContiguous, size, 0x00000000fffff000ull);
+	if (b == NULL) {
+		return NULL;
+	}
+	IOByteCount len = 0;
+	*pa = b->getPhysicalSegment(0, &len, kIOMemoryMapperNone);
+	if (*pa == 0 || len < size || *pa + size > (1ull << 32)) {
+		b->release();
+		return NULL;
+	}
+	return b;
+}
+
+/* VEN power domain, clocks, larb7 ports: once (the block stays on; it draws nothing while idle and clock-gated). */
+static bool
+powerOn(struct viva_jpgenc *j)
+{
+	if (j->powered) {
+		return true;
+	}
+	/* the parent domain (DIS, bit 21) is on whenever the display is */
+	if (!(rd(j->spm, SPM_PWR_STATUS) & (1u << 21))) {
+		IOLog("VIVA JPEG: display power domain off\n");
+		return false;
+	}
+	wr(j->topck, CLK_CFG_9_CLR, 0x7);
+	wr(j->topck, CLK_CFG_9_SET, VENC_SEL_MAINPLL_D3);
+	wr(j->topck, CLK_CFG_UPDATE, VENC_SEL_UPDATE);
+	if (!(rd(j->spm, SPM_PWR_STATUS) & VEN_STATUS_BIT) || rd(j->spm, SPM_VEN_PWR_CON) != 0xd) {
+		wr(j->spm, SPM_POWERON_CONFIG, SPM_PROJECT_KEY);
+		uint32_t v = rd(j->spm, SPM_VEN_PWR_CON);
+		v |= PWR_ON;
+		wr(j->spm, SPM_VEN_PWR_CON, v);
+		v |= PWR_ON_2ND;
+		wr(j->spm, SPM_VEN_PWR_CON, v);
+		for (int i = 0; i < 1000 && (!(rd(j->spm, SPM_PWR_STATUS) & VEN_STATUS_BIT) ||
+		    !(rd(j->spm, SPM_PWR_STATUS_2ND) & VEN_STATUS_BIT)); i++) {
+			IODelay(10);
+		}
+		if (!(rd(j->spm, SPM_PWR_STATUS) & VEN_STATUS_BIT)) {
+			IOLog("VIVA JPEG: VEN power domain did not come up (0x%08x)\n", rd(j->spm, SPM_VEN_PWR_CON));
+			return false;
+		}
+		v &= ~PWR_CLK_DIS;
+		wr(j->spm, SPM_VEN_PWR_CON, v);
+		v &= ~PWR_ISO;
+		wr(j->spm, SPM_VEN_PWR_CON, v);
+		v |= PWR_RST_B;
+		wr(j->spm, SPM_VEN_PWR_CON, v);
+		v &= ~SRAM_PDN;
+		wr(j->spm, SPM_VEN_PWR_CON, v);
+		for (int i = 0; i < 1000 && (rd(j->spm, SPM_VEN_PWR_CON) & SRAM_PDN_ACK); i++) {
+			IODelay(10);
+		}
+		if (rd(j->spm, SPM_VEN_PWR_CON) & SRAM_PDN_ACK) {
+			IOLog("VIVA JPEG: VEN SRAM did not power up (0x%08x)\n", rd(j->spm, SPM_VEN_PWR_CON));
+			return false;
+		}
+		wr(j->infra, INFRA_TOPAXI_PROTECTEN_CLR, VEN_PROT_STEP2);
+		wr(j->infra, INFRA_TOPAXI_PROTECTEN_CLR, VEN_PROT_STEP1);
+	}
+	/* only now is 0x170xxxxx on the bus */
+	wr(j->gcon, VENC_CG, rd(j->gcon, VENC_CG) | VENC_CG_ON);
+	static const uint32_t ostd[4] = { 5, 3, 1, 5 };
+	for (uint32_t p = 9; p <= 12; p++) {
+		wr(j->larb, LARB_OSTD(p), ostd[p - 9]);
+		wr(j->larb, LARB_PORT_CTRL(p), rd(j->larb, LARB_PORT_CTRL(p)) & ~LARB_PORT_MMU_BITS);
+	}
+	wr(j->jpg, JE_RSTB, 0);
+	wr(j->jpg, JE_RSTB, 1);
+	(void)rd(j->jpg, JE_ULTRA_THRES);
+	if (rd(j->jpg, JE_DMA_ADDR0) == 0xffffffff) {
+		IOLog("VIVA JPEG: jpgenc not answering on the APB bus\n");
+		return false;
+	}
+	wr(j->jpg, JE_CODEC_SEL, 0);
+	j->powered = true;
+	IOLog("VIVA JPEG: jpgenc powered (VEN 0x%08x, VENC_CG 0x%08x)\n", rd(j->spm, SPM_VEN_PWR_CON), rd(j->gcon, VENC_CG));
+	return true;
+}
+
+struct viva_jpgenc *
+viva_jpgenc_create(size_t maxPixels)
+{
+	struct viva_jpgenc *j = (struct viva_jpgenc *)IOMallocZero(sizeof(*j));
+	if (j == NULL) {
+		return NULL;
+	}
+	j->topck = mapRegs(PA_TOPCKGEN, 0x1000);
+	j->infra = mapRegs(PA_INFRACFG, 0x1000);
+	j->spm = mapRegs(PA_SPM, 0x1000);
+	j->gcon = mapRegs(PA_VENC_GCON, 0x1000);
+	j->larb = mapRegs(PA_LARB7, 0x1000);
+	j->jpg = mapRegs(PA_JPGENC, 0x1000);
+	j->srcSize = round_page(maxPixels * 2 + 64 * 1024);    /* YUYV: 2 bytes per pixel */
+	j->dstSize = round_page(maxPixels + 64 * 1024);     /* ~8 bits per pixel worst case at Q97 is far more than enough */
+	j->src = contiguous(j->srcSize, &j->srcPA);
+	j->dst = contiguous(j->dstSize, &j->dstPA);
+	if (j->topck == NULL || j->infra == NULL || j->spm == NULL || j->gcon == NULL || j->larb == NULL || j->jpg == NULL ||
+	    j->src == NULL || j->dst == NULL || !powerOn(j)) {
+		IOLog("VIVA JPEG: hardware encoder unavailable\n");
+		viva_jpgenc_destroy(j);
+		return NULL;
+	}
+	return j;
+}
+
+void
+viva_jpgenc_destroy(struct viva_jpgenc *j)
+{
+	if (j == NULL) {
+		return;
+	}
+	OSSafeReleaseNULL(j->topck);
+	OSSafeReleaseNULL(j->infra);
+	OSSafeReleaseNULL(j->spm);
+	OSSafeReleaseNULL(j->gcon);
+	OSSafeReleaseNULL(j->larb);
+	OSSafeReleaseNULL(j->jpg);
+	OSSafeReleaseNULL(j->src);
+	OSSafeReleaseNULL(j->dst);
+	IOFreeType(j, struct viva_jpgenc);
+}
+
+static uint32_t
+qualityIndex(uint32_t q)
+{
+	/* mtk_jpeg_set_param (MT6781): only these tables are ever chosen */
+	return q >= 97 ? 0x10 : q >= 95 ? 0x3 : q >= 92 ? 0x7 : q >= 90 ? 0x2 : q >= 87 ? 0xb : q >= 84 ? 0x6 :
+	       q >= 80 ? 0x1 : q >= 74 ? 0xa : q >= 64 ? 0xe : q >= 60 ? 0x0 : 0x8;
+}
+
+IOReturn
+viva_jpgenc_encode(struct viva_jpgenc *j, const struct viva_jpgenc_image *img, uint32_t quality, void *out,
+    size_t outCap, size_t *outLen, uint32_t *cyclesOut)
+{
+	*outLen = 0;
+	bool yuyv = img->format == kVivaJpegYUYV;
+	if (img->format != kVivaJpegNV12 && img->format != kVivaJpegNV21 && !yuyv) {
+		return kIOReturnUnsupported;
+	}
+	uint32_t w = img->width, h = img->height;
+	if (w < 16 || h < 16 || w > 8192 || h > 8192) {
+		return kIOReturnUnsupported;
+	}
+	/* MCU grid: 16x16 for 4:2:0, 16x8 for 4:2:2 (mtk_jpeg_set_param) */
+	uint32_t padW = (w + 15) & ~15u, padH = yuyv ? (h + 7) & ~7u : (h + 15) & ~15u;
+	uint32_t stride = yuyv ? (2 * padW + 31) & ~31u : padW;
+	size_t ySize = (size_t)stride * padH, cSize = yuyv ? 0 : (size_t)stride * padH / 2;
+	if (ySize + cSize > j->srcSize) {
+		return kIOReturnNoSpace;
+	}
+	if (!powerOn(j)) {
+		return kIOReturnNotReady;
+	}
+	/* source into the bounce buffer, edges replicated up to the MCU grid */
+	uint8_t *sy = (uint8_t *)j->src->getBytesNoCopy(), *sc = sy + ySize;
+	uint32_t rowBytes = yuyv ? 2 * (w & ~1u) : w;
+	for (uint32_t y = 0; y < padH; y++) {
+		const uint8_t *row = img->y + (size_t)(y < h ? y : h - 1) * img->yBytesPerRow;
+		uint8_t *d = sy + (size_t)y * stride;
+		memcpy(d, row, rowBytes);
+		for (uint32_t x = rowBytes; x < stride; x += yuyv ? 4 : 1) {
+			if (yuyv) {
+				memcpy(d + x, row + rowBytes - 4, 4);   /* last Y0 U Y1 V group */
+			} else {
+				d[x] = row[w - 1];
+			}
+		}
+	}
+	uint32_t ch = h / 2;
+	for (uint32_t y = 0; !yuyv && y < padH / 2; y++) {
+		const uint8_t *row = img->uv + (size_t)(y < ch ? y : ch - 1) * img->uvBytesPerRow;
+		uint32_t cw = w & ~1u;
+		memcpy(sc + (size_t)y * stride, row, cw);
+		for (uint32_t x = cw; x < padW; x += 2) {
+			sc[(size_t)y * stride + x] = row[cw - 2];
+			sc[(size_t)y * stride + x + 1] = row[cw - 1];
+		}
+	}
+	cacheClean(sy, ySize + cSize);
+	cacheClean(j->dst->getBytesNoCopy(), j->dstSize);
+	/* reset, configure, start (mtk_jpeg_device_run) */
+	wr(j->jpg, JE_RSTB, 0);
+	wr(j->jpg, JE_RSTB, 1);
+	wr(j->jpg, JE_CODEC_SEL, 0);
+	wr(j->jpg, JE_INT_STS, 0);
+	wr(j->jpg, JE_IMG_SIZE, (w << 16) | h);
+	uint32_t fmt = yuyv ? 0 : img->format == kVivaJpegNV12 ? 2 : 3;
+	wr(j->jpg, JE_CTRL, fmt << JE_CTRL_FMT_SHIFT);
+	wr(j->jpg, JE_BLK_NUM, yuyv ? (padW / 16) * (padH / 8) * 4 - 1 : (padW / 16) * (padH / 16) * 6 - 1);
+	wr(j->jpg, JE_IMG_STRIDE, stride);
+	wr(j->jpg, JE_STRIDE, stride);
+	wr(j->jpg, JE_SRC_LUMA_ADDR, (uint32_t)j->srcPA);
+	wr(j->jpg, JE_SRC_CHROMA_ADDR, (uint32_t)(j->srcPA + (yuyv ? 0 : ySize)));
+	wr(j->jpg, JE_OFFSET_ADDR, 0);
+	wr(j->jpg, JE_BYTE_OFFSET_MASK, 0);
+	wr(j->jpg, JE_DST_ADDR0, (uint32_t)j->dstPA);
+	wr(j->jpg, JE_STALL_ADDR0, (uint32_t)(j->dstPA + j->dstSize));
+	wr(j->jpg, JE_QUALITY, (rd(j->jpg, JE_QUALITY) & 0xffff0000u) | qualityIndex(quality));
+	wr(j->jpg, JE_RST_MCU_NUM, 0);
+	wr(j->jpg, JE_CTRL, ((fmt << JE_CTRL_FMT_SHIFT) | JE_CTRL_START_BITS) & ~(1u << 30));
+	uint32_t sts = 0;
+	uint64_t deadline;
+	clock_interval_to_deadline(JE_TIMEOUT_MS, kMillisecondScale, &deadline);
+	while (((sts = rd(j->jpg, JE_INT_STS)) & (JE_INT_DONE | JE_INT_STALL | JE_INT_VCODEC)) == 0 &&
+	    mach_absolute_time() < deadline) {
+		IODelay(50);
+	}
+	wr(j->jpg, JE_INT_STS, 0);
+	uint32_t produced = rd(j->jpg, JE_DMA_ADDR0) - (uint32_t)j->dstPA;
+	uint32_t cycles = rd(j->jpg, JE_TOTAL_CYCLE);
+	wr(j->jpg, JE_CTRL, fmt << JE_CTRL_FMT_SHIFT);         /* stop */
+	if (!(sts & JE_INT_DONE)) {
+		j->failures++;
+		wr(j->jpg, JE_RSTB, 0);
+		wr(j->jpg, JE_RSTB, 1);
+		IOLog("VIVA JPEG: encode %ux%u failed, status 0x%x (%s)\n", w, h, sts, sts == 0 ? "timeout" :
+		    (sts & JE_INT_STALL) ? "output full" : "codec error");
+		return sts == 0 ? kIOReturnTimeout : kIOReturnError;
+	}
+	cacheClean(j->dst->getBytesNoCopy(), produced);        /* drop stale lines: the block wrote memory */
+	if (produced > outCap) {
+		return kIOReturnNoSpace;
+	}
+	memcpy(out, j->dst->getBytesNoCopy(), produced);
+	*outLen = produced;
+	if (cyclesOut != NULL) {
+		*cyclesOut = cycles;
+	}
+	j->encodes++;
+	j->bytesOut += produced;
+	j->cycles += cycles;
+	return kIOReturnSuccess;
+}
+
+void
+viva_jpgenc_stats(struct viva_jpgenc *j, uint64_t *encodes, uint64_t *failures, uint64_t *bytes, uint64_t *cycles)
+{
+	*encodes = j->encodes;
+	*failures = j->failures;
+	*bytes = j->bytesOut;
+	*cycles = j->cycles;
+}
+
+#endif /* SWEET */
diff --git a/iokit/Kernel/arm/VivaJPEG.cpp b/iokit/Kernel/arm/VivaJPEG.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/VivaJPEG.cpp
@@ -0,0 +1,272 @@
+/*
+ * viva (MT6781): the AppleJPEGDriver that VideoToolbox's JPEG encoder (JPEGH1.videoencoder) opens, on the hardware
+ * encoder of VivaJPEGHW.cpp. ABI from iOS 16.7.16: gpu/docs/ABI-APPLEJPEGDRIVER.md in the viva-gpu repository.
+ *
+ * Phase 1 of that document: the class is VivaJPEGEncoder and only the registry *name* is "AppleJPEGDriver". The VT
+ * encoder looks the service up with IOServiceNameMatching and finds it; VT's decoder, CMPhoto and MobileGestalt match
+ * the class AppleJPEGDriver and do not, so every decode (MT6781 has no JPEG decoder) and CMPhoto's encoding stay in
+ * software exactly as without the service.
+ *
+ * Selector 3 (encode, struct 0x58 in, 0x58 out): source 'yuvf'/'yuvs' (YUYV 4:2:2) or '420f'/'420v' (NV12) IOSurface,
+ * destination IOSurface ('JPEG'); a complete JFIF file at offset 0 of the destination, out+0x10 = its size,
+ * out+0x14/+0x18 = width/height. Quality level +0x1C (0..7, VideoToolbox: higher = better) maps to the jpgenc tables.
+ * Bigger than the destination: kIOReturnOverrun with out+0x10 = the destination size (VT retries one level lower).
+ * Selectors 1, 4, 5 (decode, encode with custom tables): kIOReturnUnsupported.
+ * Registry: AppleJPEGRequiresMCUAlignment = 0 (32-bit number) lets VT hand over 420f as well as yuvf.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSDictionary.h>
+
+#include "VivaJPEG.h"
+#include "SweetSurface.h"
+
+#define FOURCC(a, b, c, d)      (((uint32_t)(a) << 24) | ((uint32_t)(b) << 16) | ((uint32_t)(c) << 8) | (uint32_t)(d))
+#define PF_YUVF                 FOURCC('y', 'u', 'v', 'f')
+#define PF_YUVS                 FOURCC('y', 'u', 'v', 's')
+#define PF_420F                 FOURCC('4', '2', '0', 'f')
+#define PF_420V                 FOURCC('4', '2', '0', 'v')
+#define JPEG_MAX_PIXELS         (4096u * 4096u)
+#define JPEG_GPU_WAIT_MS        1000
+
+struct viva_jpeg_request {              /* selectors 1/3, 0x58 bytes */
+	uint32_t srcID, srcAllocSize, dstID, dstAllocSize;
+	uint32_t written, width, height, quality, flags, cropX, cropY, chroma;
+	uint64_t callback, refcon, arg;
+	uint32_t traceID, decode[2];         /* 0x48, 0x4c-0x53 (decode only) */
+	uint32_t rstLogging;                 /* 0x54 */
+};
+static_assert(sizeof(struct viva_jpeg_request) == 0x58, "AppleJPEGDriver requests are 0x58 bytes");
+
+class VivaJPEGEncoder : public IOService {
+	OSDeclareDefaultStructors(VivaJPEGEncoder);
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn newUserClient(task_t owningTask, void *securityID, UInt32 type, IOUserClient **handler) APPLE_KEXT_OVERRIDE;
+	IOReturn encode(struct viva_jpeg_request *req);
+	void refused(void) { OSIncrementAtomic64((SInt64 *)&fRefused); }
+private:
+	void publishStats(void);
+	IOLock *fLock;
+	struct viva_jpgenc *fHW;
+	uint64_t fRefused, fErrors, fOverruns;
+};
+
+class VivaJPEGEncoderUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(VivaJPEGEncoderUserClient);
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+private:
+	VivaJPEGEncoder *fOwner;
+};
+
+OSDefineMetaClassAndStructors(VivaJPEGEncoder, IOService);
+OSDefineMetaClassAndStructors(VivaJPEGEncoderUserClient, IOUserClient);
+
+static void
+setNumber(IORegistryEntry *e, OSDictionary *d, const char *key, uint64_t value)
+{
+	OSNumber *n = OSNumber::withNumber(value, 32);
+	if (n == NULL) {
+		return;
+	}
+	if (d != NULL) {
+		d->setObject(key, n);
+	} else {
+		e->setProperty(key, n);
+	}
+	n->release();
+}
+
+bool
+VivaJPEGEncoder::start(IOService *provider)
+{
+	int mode = 0;
+	PE_parse_boot_argn("vivajpeg", &mode, sizeof(mode));
+	if (mode <= 0) {
+		IOLog("VIVA JPEG: off (boot-arg vivajpeg=1 publishes the hardware encoder)\n");
+		return false;
+	}
+	fLock = IOLockAlloc();
+	if (fLock == NULL || !IOService::start(provider)) {
+		return false;
+	}
+	fHW = viva_jpgenc_create(JPEG_MAX_PIXELS);
+	if (fHW == NULL) {
+		return false;
+	}
+	setName("AppleJPEGDriver");
+	setNumber(this, NULL, "AppleJPEGRequiresMCUAlignment", 0);
+	setNumber(this, NULL, "AppleJPEGNumCores", 1);
+	setProperty("IOUserClientClass", "VivaJPEGEncoderUserClient");
+	publishStats();
+	registerService();
+	IOLog("VIVA JPEG: AppleJPEGDriver (encode only) published\n");
+	return true;
+}
+
+IOReturn
+VivaJPEGEncoder::newUserClient(task_t owningTask, void *securityID, UInt32 type, IOUserClient **handler)
+{
+	if (type != 0) {
+		return kIOReturnUnsupported;
+	}
+	VivaJPEGEncoderUserClient *c = OSTypeAlloc(VivaJPEGEncoderUserClient);
+	if (c == NULL) {
+		return kIOReturnNoMemory;
+	}
+	if (!c->initWithTask(owningTask, securityID, type) || !c->attach(this) || !c->start(this)) {
+		c->detach(this);
+		c->release();
+		return kIOReturnError;
+	}
+	*handler = c;
+	return kIOReturnSuccess;
+}
+
+void
+VivaJPEGEncoder::publishStats(void)
+{
+	OSDictionary *d = OSDictionary::withCapacity(6);
+	if (d == NULL) {
+		return;
+	}
+	uint64_t enc = 0, fail = 0, bytes = 0, cycles = 0;
+	if (fHW != NULL) {
+		viva_jpgenc_stats(fHW, &enc, &fail, &bytes, &cycles);
+	}
+	setNumber(this, d, "encodes", enc);
+	setNumber(this, d, "failures", fail + fErrors);
+	setNumber(this, d, "overruns", fOverruns);
+	setNumber(this, d, "refused", fRefused);
+	setNumber(this, d, "bytes", bytes);
+	setNumber(this, d, "cycles", cycles);
+	setProperty("VivaJPEGStats", d);
+	d->release();
+}
+
+/* VideoToolbox's level 0..7 (7 = 'sjpg' without rate control) to a 0..100 quality for the jpgenc tables. */
+static uint32_t
+levelQuality(uint32_t level)
+{
+	static const uint8_t q[8] = { 40, 55, 65, 75, 85, 92, 97, 97 };
+	return q[level < 8 ? level : 4];
+}
+
+IOReturn
+VivaJPEGEncoder::encode(struct viva_jpeg_request *req)
+{
+	SweetSurface *src = sweet_surface_copy(req->srcID), *dst = sweet_surface_copy(req->dstID);
+	IOReturn ret = kIOReturnBadArgument;
+	if (src == NULL || dst == NULL) {
+		goto out;
+	}
+	{
+		struct viva_jpgenc_image img = {};
+		uint32_t w = req->width ? req->width : src->width, h = req->height ? req->height : src->height;
+		uintptr_t sk = src->kernelAddress(), dk = dst->kernelAddress();
+		if (sk == 0 || dk == 0 || w > src->width || h > src->height || req->cropX || req->cropY) {
+			ret = sk == 0 || dk == 0 ? kIOReturnNoMemory : kIOReturnUnsupported;
+			goto out;
+		}
+		img.width = w;
+		img.height = h;
+		if ((src->pixelFormat == PF_YUVF || src->pixelFormat == PF_YUVS) && src->bytesPerElement >= 2) {
+			img.format = kVivaJpegYUYV;
+			img.y = (const uint8_t *)sk + src->offset;
+			img.yBytesPerRow = src->bytesPerRow;
+		} else if ((src->pixelFormat == PF_420F || src->pixelFormat == PF_420V) && src->planeCount >= 2) {
+			img.format = kVivaJpegNV12;
+			img.y = (const uint8_t *)sk + src->planes[0].offset;
+			img.yBytesPerRow = src->planes[0].bytesPerRow;
+			img.uv = (const uint8_t *)sk + src->planes[1].offset;
+			img.uvBytesPerRow = src->planes[1].bytesPerRow;
+		} else {
+			ret = kIOReturnUnsupported;
+			goto out;
+		}
+		/* the encoder writes the source through the GPU possibly (pool buffers); wait, then read fresh lines */
+		if (!viva_gpu_surface_idle(src, NULL)) {
+			viva_gpu_surface_wait(src, JPEG_GPU_WAIT_MS);
+		}
+		if (!viva_gpu_surface_idle(dst, NULL)) {
+			viva_gpu_surface_wait(dst, JPEG_GPU_WAIT_MS);
+		}
+		sweet_surface_before_cpu_access(src);
+		sweet_surface_before_cpu_access(dst);
+		size_t cap = dst->allocSize, len = 0;
+		IOLockLock(fLock);
+		ret = viva_jpgenc_encode(fHW, &img, levelQuality(req->quality), (uint8_t *)dk, cap, &len, NULL);
+		if (ret == kIOReturnNoSpace) {
+			fOverruns++;
+		} else if (ret != kIOReturnSuccess) {
+			fErrors++;
+		}
+		IOLockUnlock(fLock);
+		if (ret == kIOReturnSuccess) {
+			sweet_surface_cpu_wrote(dst);
+			req->written = (uint32_t)len;
+			req->width = w;
+			req->height = h;
+		} else if (ret == kIOReturnNoSpace) {
+			req->written = (uint32_t)cap;
+			ret = kIOReturnOverrun;     /* VideoToolbox retries one quality level lower */
+		}
+	}
+out:
+	OSSafeReleaseNULL(src);
+	OSSafeReleaseNULL(dst);
+	publishStats();
+	return ret;
+}
+
+bool
+VivaJPEGEncoderUserClient::start(IOService *provider)
+{
+	fOwner = OSDynamicCast(VivaJPEGEncoder, provider);
+	return fOwner != NULL && IOUserClient::start(provider);
+}
+
+IOReturn
+VivaJPEGEncoderUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+VivaJPEGEncoderUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target, __unused void *reference)
+{
+	switch (selector) {
+	case 3: {
+		if (args->structureInput == NULL || args->structureInputSize != sizeof(struct viva_jpeg_request) ||
+		    args->structureOutput == NULL || args->structureOutputSize < sizeof(struct viva_jpeg_request)) {
+			return kIOReturnBadArgument;
+		}
+		struct viva_jpeg_request req;
+		memcpy(&req, args->structureInput, sizeof(req));
+		IOReturn ret = fOwner->encode(&req);
+		memcpy(args->structureOutput, &req, sizeof(req));
+		args->structureOutputSize = sizeof(req);
+		return ret;
+	}
+	case 1:
+	case 4:
+	case 5:
+		fOwner->refused();      /* decode / custom tables: the clients keep (or fall back to) software */
+		return kIOReturnUnsupported;
+	default:
+		return kIOReturnBadArgument;
+	}
+}
+
+#endif /* SWEET */

diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
index a20a764..fa4ea47 100644
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -1040,6 +1040,62 @@ sweet_sample_task(const char *name, int pid, task_t task)
 	task_unlock(task);
 }
 
+/*
+ * 0201: link command `ps NAME|PID` (bsd/dev/viva_usb.c). Where is a process stuck *in the kernel*? Per thread:
+ * state, block hint, wait event, the user pc/lr and, for a blocked thread, a frame-pointer backtrace of its kernel
+ * stack from the context saved at the switch. Kernel collection addresses are unslid (symbolicate against the
+ * kernelcache's own addresses), heap addresses (wait events on objects) printed as they are. Racy by design (no
+ * thread locks): only frames inside the thread's own kernel stack are followed.
+ */
+void sweet_ps_task(const char *name, int pid, task_t task);
+
+/* text and data of the kernel collection unslid (symbolicate), anything else (heap) as it is */
+#define SPS_ADDR(v) ((unsigned long)(VM_KERNEL_IS_SLID(v) ? __DO_UNSLIDE(v) : (vm_offset_t)VM_KERNEL_STRIP_PTR(v)))
+
+void
+sweet_ps_task(const char *name, int pid, task_t task)
+{
+	int tn = 0;
+	thread_t thread;
+
+	printf("PS %s[%d] threads %d\n", name, pid, task->thread_count);
+	task_lock(task);
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		char line[480];
+		int n;
+		int state = thread->state;
+		arm_saved_state_t *ss = find_user_regs(thread);
+
+		n = snprintf(line, sizeof(line), "PS %s t%d tid %llu state %s%s%s%s%s hint %d event 0x%lx", name, tn++,
+		    thread_tid(thread), (state & TH_WAIT) ? "W" : "", (state & TH_RUN) ? "R" : "", (state & TH_UNINT) ? "U" : "",
+		    (state & TH_SUSP) ? "S" : "", (state & TH_TERMINATE) ? "T" : "", (int)thread->block_hint,
+		    SPS_ADDR(thread->wait_event));
+		if (ss != NULL && is_saved_state64(ss)) {
+			n += snprintf(line + n, sizeof(line) - n, " upc 0x%llx ulr 0x%llx", get_saved_state_pc(ss),
+			    get_saved_state_lr(ss));
+		}
+		vm_offset_t stack = thread->kernel_stack;
+		if ((state & TH_WAIT) && !(state & TH_RUN) && stack != 0 && thread != current_thread()) {
+			struct arm_kernel_saved_state *ks = &((thread_kernel_state_t)thread->machine.kstackptr)->machine.ss;
+			uint64_t fp = ks->fp, top = stack + kernel_stack_size;
+			n += snprintf(line + n, sizeof(line) - n, " kbt 0x%lx", SPS_ADDR(ks->lr));
+			for (int i = 0; i < 24 && fp >= stack && fp + 16 <= top && (fp & 7) == 0 && n < (int)sizeof(line) - 24; i++) {
+				uint64_t *frame = (uint64_t *)fp;
+				n += snprintf(line + n, sizeof(line) - n, " 0x%lx", SPS_ADDR(frame[1]));
+				if (frame[0] <= fp) {
+					break;
+				}
+				fp = frame[0];
+			}
+		} else if ((state & TH_WAIT) && stack == 0) {
+			n += snprintf(line + n, sizeof(line) - n, " (continuation 0x%lx)",
+			    SPS_ADDR(thread->continuation));
+		}
+		printf("%s\n", line);
+	}
+	task_unlock(task);
+}
+
 #endif /* ARM64_BOARD_CONFIG_SWEET */
 
 kern_return_t

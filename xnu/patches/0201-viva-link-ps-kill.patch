diff --git a/bsd/dev/sweet_sample.c b/bsd/dev/sweet_sample.c
index b40eccd..69216c1 100644
--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -86,3 +86,103 @@ sweet_sample_start(void)
 		thread_deallocate(thread);
 	}
 }
+
+/*
+ * 0201: link commands `ps [NAME|PID]` and `kill PID [SIG]` (bsd/dev/viva_usb.c), for processes stuck where nothing
+ * else on the phone can look (vivad blocked in posix_spawn, 2026-11-13). `ps` alone: one line per process in the log;
+ * with a name or pid: every thread (osfmk/kern/exception.c sweet_ps_task). Output in the log ("PS ..." lines), the
+ * reply only counts. `kill` refuses pid 0 and 1.
+ */
+#include <sys/signalvar.h>
+
+extern void sweet_ps_task(const char *name, int pid, task_t task);   /* osfmk/kern/exception.c */
+
+struct sweet_ps_arg {
+	const char *name;
+	int pid, found;
+};
+
+static int
+sweet_ps_proc(proc_t p, void *varg)
+{
+	struct sweet_ps_arg *a = varg;
+	char name[32];
+	task_t task = proc_task(p);
+	proc_name(proc_pid(p), name, sizeof(name));
+	if (a->name == NULL && a->pid < 0) {
+		printf("PS %5d %-24s threads %d\n", proc_pid(p), name, task != TASK_NULL ? get_task_numacts(task) : 0);
+		a->found++;
+	} else if ((a->pid >= 0 && proc_pid(p) == a->pid) || (a->name != NULL && strcmp(name, a->name) == 0)) {
+		if (task != TASK_NULL) {
+			sweet_ps_task(name, proc_pid(p), task);
+			a->found++;
+		}
+	}
+	return PROC_RETURNED;
+}
+
+void sweet_ps(const char *arg, char *out, size_t len);
+void sweet_kill(const char *arg, char *out, size_t len);
+
+/* decimal number at *s (spaces skipped); -1 if none */
+static int
+sweet_num(const char **s)
+{
+	int v = -1;
+	while (**s == ' ') {
+		(*s)++;
+	}
+	while (**s >= '0' && **s <= '9' && v < 100000000) {
+		v = (v < 0 ? 0 : v * 10) + (*(*s)++ - '0');
+	}
+	return v;
+}
+
+void
+sweet_ps(const char *arg, char *out, size_t len)
+{
+	struct sweet_ps_arg a = { .name = NULL, .pid = -1, .found = 0 };
+	char name[32];
+	while (*arg == ' ') {
+		arg++;
+	}
+	if (*arg >= '0' && *arg <= '9') {
+		const char *q = arg;
+		a.pid = sweet_num(&q);
+	} else if (*arg) {
+		size_t n = 0;
+		while (arg[n] && arg[n] != ' ' && n < sizeof(name) - 1) {
+			name[n] = arg[n];
+			n++;
+		}
+		name[n] = 0;
+		a.name = name;
+	}
+	printf("PS --- %s\n", *arg ? arg : "all");
+	proc_iterate(PROC_ALLPROCLIST, sweet_ps_proc, &a, NULL, NULL);
+	snprintf(out, len, "ps: %d process%s, \"PS\" lines in the log\n", a.found, a.found == 1 ? "" : "es");
+}
+
+void
+sweet_kill(const char *arg, char *out, size_t len)
+{
+	int pid = sweet_num(&arg), sig = sweet_num(&arg);
+	if (sig < 0) {
+		sig = SIGKILL;
+	}
+	if (pid <= 1 || sig <= 0 || sig >= NSIG) {
+		snprintf(out, len, "kill PID [SIG]: pid > 1, signal 1..%d (default 9)\n", NSIG - 1);
+		return;
+	}
+	proc_t p = proc_find(pid);
+	if (p == PROC_NULL) {
+		snprintf(out, len, "kill: no process %d\n", pid);
+		return;
+	}
+	char name[32];
+	proc_name(pid, name, sizeof(name));
+	psignal(p, sig);
+	proc_rele(p);
+	printf("VIVA LINK: kill %d (%s) signal %d\n", pid, name, sig);
+	snprintf(out, len, "kill: signal %d sent to %d (%s)\n", sig, pid, name);
+}

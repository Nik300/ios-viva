+static bool
+mac_valid(const uint8_t *m)
+{
+	static const uint8_t zero[6], ff[6] = { 0xff, 0xff, 0xff, 0xff, 0xff, 0xff };
+	return memcmp(m, zero, 6) != 0 && memcmp(m, ff, 6) != 0 && !(m[0] & 1);
+}

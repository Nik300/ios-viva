+/*
+ * TOPRGU software reset, as the link's "reboot" (measured to come back through preloader/LK). WDT_MODE as
+ * wdt_arch_reset: never interrupt-only / dual mode, or SWRST would only raise an IRQ (logged, the link
+ * never saw it set). EXTEN (also reset the PMIC) is left as LK set it, like the link command.
+ */
+void
+VivaPwrap::toprguReset(void)
+{
+	uint32_t mode = *(volatile uint32_t *)(fRGU + WDT_MODE);
+	IOLog("VIVA PWRAP: TOPRGU software reset (WDT_MODE 0x%08x)\n", mode);
+	if (mode & (WDT_MODE_IRQ | WDT_MODE_DUAL_MODE)) {
+		*(volatile uint32_t *)(fRGU + WDT_MODE) = (mode & 0xffffff & ~(WDT_MODE_IRQ | WDT_MODE_DUAL_MODE)) |
+		    WDT_MODE_KEY;
+		IODelay(100);
+	}
+	for (;;) {
+		*(volatile uint32_t *)(fRGU + WDT_SWRST) = WDT_SWRST_KEY;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		IODelay(5000);
+	}
+}
+
+void
+VivaPwrap::restart(void)
+{
+	bool held = holdForHalt();
+	IOLog("VIVA PWRAP: restart (pwrap %s)\n", held ? "held" : "busy");
+	toprguReset();
+}
+
+/*
+ * mt_power_off (mt6358-misc.c, viva-r-oss): the RTC "lpsd" step (alarm/spare state cleared, power-on alarm
+ * kept, DOW masked), the shutdown delay workaround, then PWRHOLD = 0: the PMIC drops every rail. With a
+ * charger in, the PMIC powers straight back up (LK: charging screen); if this CPU still runs after 1 s
+ * (vendor: 10 x 100 ms, then arch_reset), the watchdog resets it. Not done (vendor extras): disabling the
+ * RTC 32 kHz export (RTC_CON.F32KOB) and the EOSC calibration of the shutdown callback.
+ */
+void
+VivaPwrap::powerOff(void)
+{
+	bool held = holdForHalt();
+	uint32_t bbpu = 0, prot = 0, almask = 0;
+	readNoLock(MT6358_RTC_BBPU, &bbpu);
+	readNoLock(MT6358_RTC_PROT, &prot);
+	readNoLock(MT6358_RTC_AL_MASK, &almask);
+	IOLog("VIVA PWRAP: power off (pwrap %s): RTC_BBPU 0x%04x PROT 0x%04x AL_MASK 0x%04x\n",
+	    held ? "held" : "busy", bbpu, prot, almask);
+
+	IOReturn r1 = writePowerOff(MT6358_RTC_BBPU, 0x433f, RTC_BBPU_KEY | RTC_BBPU_CLR | RTC_BBPU_PWREN);
+	IOReturn r2 = writePowerOff(MT6358_RTC_AL_MASK, RTC_AL_MASK_DOW, RTC_AL_MASK_DOW);
+	bool t1 = rtcWriteTrigger();
+	int clr;
+	for (clr = 0; clr < 50000; clr++) {             /* mtk_rtc_spar_alarm_clear_wait: CLR self-clears */
+		if (readNoLock(MT6358_RTC_BBPU, &bbpu) == kIOReturnSuccess && !(bbpu & RTC_BBPU_CLR)) {
+			break;
+		}
+		IODelay(10);
+	}
+	IOReturn r3 = writePowerOff(MT6358_RTC_BBPU, 0x433f, (bbpu & 0x3f) | RTC_BBPU_KEY | RTC_BBPU_RELOAD);
+	bool t2 = rtcWriteTrigger();
+
+	IOReturn r4 = writePowerOff(MT6358_TOP_TMA_KEY, 0xffff, 0x9ca7);
+	IOReturn r5 = writePowerOff(MT6358_PSEQ_ELR11, RG_SDN_DLY_ENB, 0);
+	writePowerOff(MT6358_TOP_TMA_KEY, 0xffff, 0);
+
+	readNoLock(MT6358_RTC_BBPU, &bbpu);
+	readNoLock(MT6358_RTC_AL_MASK, &almask);
+	IOLog("VIVA PWRAP: RTC lpsd %d/%d/%d trigger %d/%d clr %d us, BBPU 0x%04x AL_MASK 0x%04x, sdn delay %d/%d; "
+	    "PWRHOLD = 0\n", r1, r2, r3, t1, t2, clr * 10, bbpu, almask, r4, r5);
+	/* hook: panel/backlight off goes before this point (display driver, see SweetPlatformExpert::haltRestart) */
+	writePowerOff(MT6358_PPCCTL0, RG_PWRHOLD, 0);
+
+	for (int i = 0; i < 100; i++) {
+		IODelay(10000);
+	}
+	IOLog("VIVA PWRAP: still on 1 s after PWRHOLD = 0 (charger?), watchdog reset\n");
+	toprguReset();
+}
+
+/* SweetPlatformExpert::haltRestart: kPEHaltCPU / kPEUPSDelayHaltCPU / kPERestartCPU outside a panic. -1 = not
+ * viva (sweet), the pwrap never started, or vivapoweroff=0: the caller keeps IOPlatformExpert's behaviour. */
+extern "C" int
+viva_halt_restart(unsigned int type)
+{
+	if (gVivaPwrap == NULL || !gVivaPwrap->haltRestartReady()) {
+		return -1;
+	}
+	if (type == kPEHaltCPU || type == kPEUPSDelayHaltCPU) {
+		gVivaPwrap->powerOff();
+	}
+	if (type == kPERestartCPU) {
+		gVivaPwrap->restart();
+	}
+	return -1;
+}
 #endif /* SWEET */

+/* 0192, work loop: display off (see "Panel power" at the top). */
+void
+AppleCLCD::panelSleep(void)
+{
+	static const uint8_t blOff[3] = { 0x51, 0x00, 0x00 }, dispOff[1] = { 0x28 }, sleepIn[1] = { 0x10 };
+	IOLockLock(fLock);
+	if (!fPowerOff) {
+		fPowerOff = true;
+		fFadeStep = 0;          /* a failed sleep fades as before 0192 */
+	}
+	IOLockUnlock(fLock);
+	if (fPanelOff) {
+		return;                 /* already asleep */
+	}
+	uint64_t t0 = mach_absolute_time();
+	const char *why = NULL;
+	IOLockLock(fScanLock);
+	dropNext();                     /* a frame chosen for the next frame end: retired unseen */
+	if (!dispMap()) {
+		why = "display registers not mappable";
+	} else if ((disp_rd(fDisp[4], DSI_MODE_CTRL) & 3) == 0) {
+		why = "DSI not in video mode";
+	} else {
+		/* 120 Hz: back to 60 first (the panel takes the mode command only awake; half the DSI / OVL frames) */
+		if (fPanelHz == 120 && !panelSetHz(60)) {
+			fHzFailures++;
+		}
+		fBlRestore = fBlLevel != 0 ? fBlLevel : 0x219;  /* 0 = never set: LK's level */
+		/* vendor lcm_disable (backlight off), then lcm_unprepare: 28, 10 ms, 10, 110 ms */
+		if (!dsiSendDcs(blOff, 3, false) || !dsiSendDcs(dispOff, 1, false)) {
+			why = "display off not sent (VM_CMD_DONE timeout)";
+		}
+	}
+	IOLockUnlock(fScanLock);
+	if (why != NULL) {
+		fPanelFails++;
+		fPanelWhy = why;
+		IOLog("SWEET FB: display off, the panel stays on (%s): fade to black\n", why);
+		return;                 /* fPowerOff with fFadeStep 0: the vsync tick fades as before 0192 */
+	}
+	IOSleep(10);
+	IOLockLock(fScanLock);
+	bool slept = dsiSendDcs(sleepIn, 1, false);
+	IOLockUnlock(fScanLock);
+	IOSleep(120);                   /* vendor 110 ms; sleep out must not come within 120 ms of sleep in either */
+	IOLockLock(fScanLock);
+	fVfpSaved = 0;
+	if (fOffVfp != 0) {
+		/* nothing to show: frames at about 8/s instead of 60 (vendor DSI_VFP_IDLE_MODE does the same for idle) */
+		fVfpSaved = disp_rd(fDisp[4], DSI_VFP_NL);
+		disp_wr(fDisp[4], DSI_VFP_NL, fOffVfp);
+	}
+	IOLockUnlock(fScanLock);
+	IOLockLock(fLock);
+	fPanelOff = true;
+	fFadeStep = 7;                  /* no fade: the panel is dark */
+	IOLockUnlock(fLock);
+	if (sweet_fb_panic_hook == NULL) {
+		sweet_fb_panic_hook = sweet_fb_panic_show;      /* a panic wakes the panel to show itself */
+	}
+	if (!slept) {
+		fPanelFails++;
+		fPanelWhy = "sleep in not sent (VM_CMD_DONE timeout): display off only";
+	}
+	fPanelOffs++;
+	fPanelOffAt = mach_absolute_time();
+	fPanelOffUs = absUsFB(fPanelOffAt - t0);
+	IOLog("SWEET FB: display off: panel asleep%s in %llu us (level %u kept, VFP %u -> %u)\n",
+	    slept ? "" : " (sleep in NOT sent)", fPanelOffUs, fBlRestore, fVfpSaved, fOffVfp);
+	fVsync->setTimeoutMS(fOffTickMs);       /* the slow tick from now on (offTick) */
+}
+
+/* 0192, work loop: display on (see "Panel power" at the top). */
+void
+AppleCLCD::panelWake(void)
+{
+	static const uint8_t sleepOut[1] = { 0x11 }, dispOn[1] = { 0x29 };
+	if (!fPanelOff) {
+		IOLockLock(fLock);
+		if (fPowerOff) {        /* the fade after a failed sleep (or none at all) */
+			fPowerOff = false;
+			fFadeStep = 0;
+			fDirty = true;  /* redraw the latest frame */
 		}
+		IOLockUnlock(fLock);
+		return;
 	}
+	uint64_t t0 = mach_absolute_time();
+	IOLockLock(fScanLock);
+	vm_offset_t d = fDisp[4];
+	if (fVfpSaved != 0) {
+		disp_wr(d, DSI_VFP_NL, fVfpSaved);
+		fVfpSaved = 0;
+		/* the frame in progress may still run the long porch: two frame ends, then the timing is the panel's */
+		if (fVblankOvl >= 0) {
+			vm_offset_t b = fDisp[fVblankOvl];
+			disp_wr(b, OVL_INTSTA, disp_rd(b, OVL_INTSTA) & ~OVL_INT_FME_CPL);
+			for (int seen = 0, ms = 0; seen < 2 && ms < 300; ms += 2) {
+				IOSleep(2);
+				if (disp_rd(b, OVL_INTSTA) & OVL_INT_FME_CPL) {
+					disp_wr(b, OVL_INTSTA, disp_rd(b, OVL_INTSTA) & ~OVL_INT_FME_CPL);
+					seen++;
+				}
+			}
+		} else {
+			IOSleep(160);   /* no frame end known: one long frame and one normal */
+		}
+	}
+	bool ok = dsiSendDcs(sleepOut, 1, false);
 	IOLockUnlock(fScanLock);
+	IOSleep(120);                   /* vendor lcm_panel_init: 11, 20 ms, the init table, 100 ms, then 29 */
+	uint32_t want = fBlWant, level = want != 0xffffffffu && want != 0 ? want : fBlRestore;
+	if (want != 0xffffffffu) {
+		OSCompareAndSwap(want, 0xffffffffu, &fBlWant);  /* a newer one is sent by the next tick */
+	}
+	if (level == 0) {
+		level = 0x219;
+	}
+	uint8_t bl[3] = { 0x51, (uint8_t)(level >> 8), (uint8_t)level };
+	IOLockLock(fScanLock);
+	ok = dsiSendDcs(bl, 3, false) && ok;
+	ok = dsiSendDcs(dispOn, 1, false) && ok;
+	fBlLevel = level;
+	fBlSent++;
+	if (fFlipReady && !vblankCalibrate(NULL, NULL)) {
+		fFlipReady = false;
+		fFlipWhy = "no frame end after the panel woke";
+	}
+	IOLockUnlock(fScanLock);
+	if (fBacklight != NULL) {
+		fBacklight->publishLevel(level);
+	}
+	if (fHzMode == 120) {
+		fHzWant = 120;          /* auto: from the next swap */
+	}
+	uint64_t now = mach_absolute_time();
+	IOLockLock(fLock);
+	fPanelOff = false;
+	fPowerOff = false;
+	fFadeStep = 0;
+	fDirty = true;                  /* the latest frame (swaps while asleep were retired, not shown) */
+	IOLockUnlock(fLock);
+	fLastActivity = now;
+	if (!ok) {
+		fPanelFails++;
+		fPanelWhy = "wake command not sent (VM_CMD_DONE timeout)";
+	}
+	fPanelOns++;
+	fPanelOffTotal += now - fPanelOffAt;
+	fPanelOnUs = absUsFB(now - t0);
+	IOLog("SWEET FB: display on: panel awake%s in %llu us (level %u)\n", ok ? "" : " (a command NOT sent)",
+	    fPanelOnUs, level);
+	rearm(fVsync);                  /* the panel's tick again */
 }
 
+/* 0192, the vsync timer while the panel sleeps: notifications go on slowly, queued swaps are retired unseen. */
+void
+AppleCLCD::offTick(IOTimerEventSource *timer)
+{
+	lightTick();                    /* color matrix only (brightness waits for the wake) */
+	uint64_t count = ++fVsyncCount;
+	uint64_t now = mach_absolute_time();
+	fLastNotifyAt = now;
+	uint64_t period = fPeriod * (fFlipReady ? fTickFrames : 1);
+	if (period == 0) {
+		nanoseconds_to_absolutetime((uint64_t)fTickUs * 1000, &period);
+	}
+	uint64_t values[6] = {
+		(uint32_t)count, (uint32_t)(count >> 32),
+		(uint32_t)now, (uint32_t)(now >> 32),
+		(uint32_t)period, (uint32_t)(period >> 32),
+	};
+	IOLockLock(fLock);

+	nanoseconds_to_absolutetime((uint64_t)gBoostWinMs * NSEC_PER_MSEC, &gBoostWinAbs);
+	nanoseconds_to_absolutetime((uint64_t)gBoostGapMs * NSEC_PER_MSEC, &gBoostGapAbs);
+	nanoseconds_to_absolutetime((uint64_t)gBoostHoldMs * NSEC_PER_MSEC, &gBoostHoldAbs);
+	for (int d = DOM_LL; d <= DOM_BIG; d++) {
+		gBoostIdx[d] = idx_at_most(d, gBoostMhz);
+		gBoostSwapIdx[d] = gBoostSwapMhz == 0 ? gBoostIdx[d] : idx_at_most(d, gBoostSwapMhz);
+		if (gBoostSwapIdx[d] < gBoostIdx[d]) {

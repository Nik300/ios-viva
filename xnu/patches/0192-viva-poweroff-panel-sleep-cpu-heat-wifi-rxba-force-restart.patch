+IOReturn
+AppleCLCD::powerAction(OSObject *owner, void *arg0, void *arg1 __unused, void *arg2 __unused, void *arg3 __unused)
+{
+	AppleCLCD *fb = (AppleCLCD *)owner;
+	if (arg0 != NULL) {
+		fb->panelSleep();
+	} else {
+		fb->panelWake();
+	}
+	return kIOReturnSuccess;
+}

+/* vw_mtx held: before the RX of a pass, the interrupt state is checked and its status acked. */
+static void
+irq_pass(bool timerWake)
+{
+	if (vi.mode && !vi.armed) {                     /* the handler gave the line up */
+		printf("VIVA WIFI: WFDMA interrupt fired while masked (%u times), polling\n", vi.stray);
+		irq_off();

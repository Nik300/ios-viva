+/*
+ * The WFDMA interrupt (0192): GIC SPI 0x11d, level high (Linux DT wifi@18000000; gen4m axi.c glBusSetIrq). The ADT
+ * wlan node has no interrupts property, so its nub gets the IOKit pair here: IOInterruptControllers = the GIC's
+ * name (SweetGIC registered it from its nub's phandle), IOInterruptSpecifiers = <INTID flags> as SweetGIC reads them.
+ * The handler is viva_wifi_intr() (interrupt context): false = not ours, the line is disabled.
+ */
+extern "C" bool viva_wifi_intr(void);
+
+static IOService *gVivaWiFiIrqNub;
+
+static void
+vivaWiFiInterrupt(OSObject *target __unused, void *refCon __unused, IOService *nub, int source)
+{
+	if (!viva_wifi_intr()) {
+		nub->disableInterrupt(source);
+	}
+}
+
+extern "C" int
+viva_wifi_irq_attach(uint32_t intid)
+{
+	if (gVivaWiFiIrqNub != NULL) {
+		return 0;
+	}
+	IORegistryEntry *e = IORegistryEntry::fromPath("/arm-io/wlan", gIODTPlane);
+	IOService *nub = OSDynamicCast(IOService, e);
+	if (nub == NULL) {
+		OSSafeReleaseNULL(e);
+		return 2;               /* ENOENT */
+	}
+	OSDictionary *match = IOService::serviceMatching("SweetGIC");
+	IOService *gic = match != NULL ? IOService::copyMatchingService(match) : NULL;
+	OSSafeReleaseNULL(match);
+	const OSSymbol *name = (gic != NULL && gic->getProvider() != NULL) ? IODTInterruptControllerName(gic->getProvider()) : NULL;
+	OSSafeReleaseNULL(gic);
+	if (name == NULL) {
+		nub->release();
+		return 19;              /* ENODEV */
+	}
+	if (nub->getProperty(gIOInterruptControllersKey) == NULL) {
+		uint32_t cells[2] = { intid, 4 };       /* IRQ_TYPE_LEVEL_HIGH */
+		OSData *spec = OSData::withBytes(cells, sizeof(cells));
+		OSArray *ctls = OSArray::withObjects((const OSObject **)&name, 1);
+		OSArray *specs = spec != NULL ? OSArray::withObjects((const OSObject **)&spec, 1) : NULL;
+		if (ctls != NULL && specs != NULL) {
+			nub->setProperty(gIOInterruptControllersKey, ctls);
+			nub->setProperty(gIOInterruptSpecifiersKey, specs);
+		}
+		OSSafeReleaseNULL(spec);
+		OSSafeReleaseNULL(ctls);
+		OSSafeReleaseNULL(specs);
+	}
+	name->release();
+	IOReturn ret = nub->registerInterrupt(0, nub, vivaWiFiInterrupt, NULL);
+	if (ret != kIOReturnSuccess) {
+		IOLog("VIVA WIFI: interrupt INTID %u not registered (0x%x)\n", intid, (unsigned)ret);
+		nub->release();
+		return 5;               /* EIO */
+	}
+	IOLog("VIVA WIFI: WFDMA interrupt INTID %u on %s\n", intid, nub->getName());
+	gVivaWiFiIrqNub = nub;          /* the reference is kept */
+	return 0;
+}
+
+extern "C" void
+viva_wifi_irq_enable(bool on)
+{
+	if (gVivaWiFiIrqNub != NULL) {
+		if (on) {
+			gVivaWiFiIrqNub->enableInterrupt(0);
+		} else {
+			gVivaWiFiIrqNub->disableInterrupt(0);
+		}
+	}
+}
 #endif /* SWEET */

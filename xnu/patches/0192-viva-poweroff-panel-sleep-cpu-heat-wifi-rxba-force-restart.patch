+/*
+ * 0192: RequestPowerChange, the link's "disp panel off|on" and sweet_fb_panel_off_for_halt. With vivapaneloff=1 the
+ * panel sequences run on the work loop (serialized with the vsync tick and with each other: a request that comes
+ * during a transition waits for it, then finds the state it asked for or does the opposite one).
+ */
+IOReturn
+AppleCLCD::requestPower(bool off, bool force)
+{
+	viva_cpufreq_display_power(!off);       /* never blocks */
+	if ((!fPanelMode && !force && !fPanelOff) || fWorkLoop == NULL) {
+		IOLockLock(fLock);
+		if (off != fPowerOff) {
+			fPowerOff = off;
+			fFadeStep = 0;
+			fDirty = true;     /* on: redraw the latest frame */
+		}
+		IOLockUnlock(fLock);
+		return kIOReturnSuccess;
+	}
+	return fWorkLoop->runAction(&AppleCLCD::powerAction, this, off ? (void *)1 : NULL);
+}

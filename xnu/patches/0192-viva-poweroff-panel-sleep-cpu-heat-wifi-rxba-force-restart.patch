+	}
+	if (vi.mode && timerWake && vi.count == 0 && vi.missed >= 32) {
+		printf("VIVA WIFI: WFDMA interrupt never fired (%u frames found by the timer), polling\n", vi.missed);
+		irq_off();
+		vi.gaveUp = true;
+	}
+	if (vi.mode) {
+		wr(WF_INT_STA, WF_INT_RX);              /* ack first: what lands after it raises the line again */

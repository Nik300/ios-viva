+/* The fastest OPP of d not above mhz (0 = the fastest OPP), never below the floor. */
+static int
+idx_at_most(int d, int mhz)
+{
+	int i = 0;
+	if (mhz > 0) {
+		i = idx_for_mhz(d, (unsigned)mhz);
+		while (i < gFloor && kOpp[d][i].mhz > (unsigned)mhz) {
+			i++;
+		}
+	}
+	return i > gFloor ? gFloor : i;

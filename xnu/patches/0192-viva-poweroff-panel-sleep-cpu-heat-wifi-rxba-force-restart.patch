+/* ---- RX passes and the WFDMA interrupt (0192) ---- */
+
+/*
+ * The WFDMA raises GIC SPI 0x11d (DT wifi@18000000, level high) while INT_STA & INT_MSK has a bit; gen4m's ISR
+ * (axi.c mtk_axi_interrupt) only masks it and wakes the HIF thread, which acks INT_STA, drains the rings and unmasks
+ * (cmm_asic_connac.c asicPdmaIntMaskConfig: rx_done 0/1 = bits 0/1). Here the handler masks INT_MSK and wakes the
+ * worker; the worker acks, drains, and unmasks under vw_mtx before it sleeps, so one interrupt covers a whole burst.
+ * The line is attached on the wlan nub by VivaWiFi.cpp. Never firing (frames found by the safety timer only) or
+ * firing while masked (not this line): back to polling, said once.
+ */
+#define WF_INT_RX               0x3u            /* rx_done_0 (data), rx_done_1 (events, MSDU reports) */
+#define WIFI_INTID              (32 + 0x11d)
+#define IRQ_SAFETY_MS           50              /* worker timeout with the interrupt on */
+#define HOT_MS                  100             /* fast polls this long after the last RX/TX */
+
+static struct {
+	volatile bool armed;            /* the handler may touch WFDMA registers */
+	volatile bool masked;           /* the handler masked INT_MSK, the worker has not unmasked yet */
+	volatile bool pending;          /* the handler ran since the worker last looked */
+	bool     mode;                  /* the worker relies on the interrupt */
+	bool     attached, gaveUp;      /* gaveUp: attach failed or the line misbehaved, until "wifi opt irq 1" */
+	int      err;                   /* viva_wifi_irq_attach() */
+	uint32_t count, stray, missed;  /* interrupts, interrupts while masked, frames found by the safety timer */
+	uint32_t strayRun;
+	uint32_t wIrq, wTimer, wKick;   /* worker wakeups by cause */
+	uint32_t passes, passRx, rx, maxRx, tx;
+	uint64_t last;                  /* last pass with RX or TX */
+} vi;
+
+/* GIC handler (interrupt context, CPU 0). False: not ours, the caller disables the line. */
+bool
+viva_wifi_intr(void)
+{
+	if (!vi.armed) {
+		return false;
+	}
+	if (vi.masked) {
+		vi.stray++;                             /* asserted with INT_MSK 0: another source, if it goes on */
+		if (++vi.strayRun > 8) {
+			vi.armed = false;
+			return false;
+		}
+		return true;
+	}
+	wr(WF_INT_MSK, 0);
+	(void)rd(WF_INT_MSK);                           /* the write reached the WFDMA before the GIC's EOI */
+	vi.masked = true;
+	vi.strayRun = 0;
+	vi.count++;
+	vi.pending = true;
+	wakeup(&vw_chan);
+	return true;
+}
+
+/* vw_mtx held, radio up: take the interrupt if asked for. */
+static void
+irq_on(void)
+{
+	if (vi.mode || !vt.irq || !wl.init || vi.gaveUp) {
+		return;
+	}
+	if (!vi.attached) {
+		vi.err = viva_wifi_irq_attach(WIFI_INTID);
+		vi.attached = vi.err == 0;
+		if (!vi.attached) {
+			printf("VIVA WIFI: no WFDMA interrupt (error %d), polling\n", vi.err);
+			vi.gaveUp = true;
+			return;
+		}
+	}
+	wr(WF_INT_MSK, 0);
+	wr(WF_INT_STA, WF_INT_RX);
+	vi.masked = true;                               /* the worker unmasks after its next pass */
+	vi.pending = false;
+	vi.armed = true;
+	vi.mode = true;
+	viva_wifi_irq_enable(true);
+}
+
+/* Back to polling (radio going off, "wifi opt irq 0", or the line misbehaved). */
+static void
+irq_off(void)
+{
+	bool was = vi.mode;
+	vi.armed = false;
+	vi.mode = false;
+	if (vi.attached) {
+		viva_wifi_irq_enable(false);
+	}
+	if (was && vw.on) {
+		wr(WF_INT_MSK, 0);
+	}
+	vi.masked = false;

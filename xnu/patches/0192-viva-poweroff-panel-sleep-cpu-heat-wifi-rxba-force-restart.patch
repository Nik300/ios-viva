+static bool gVivaHalting;
+
+bool
+VivaPwrap::holdForHalt(void)
+{
+	gVivaHalting = true;
+	if (ml_get_interrupts_enabled() && !ml_at_interrupt_context()) {
+		IOLockLock(fLock);              /* the normal case: CPU DVFS / the link let go within microseconds */
+		return true;
+	}
+	for (int i = 0; i < 20000; i++) {       /* not expected (interrupts off): poll ~20 ms, then go on anyway */
+		if (IOLockTryLock(fLock)) {
+			return true;
+		}
+		IODelay(1);
+	}
+	return false;
+}
+
+IOReturn
+VivaPwrap::writePowerOff(uint32_t addr, uint32_t mask, uint32_t value)
+{
+	unsigned int i;
+	for (i = 0; i < sizeof(gVivaPowerOffRegs) / sizeof(gVivaPowerOffRegs[0]); i++) {
+		if (gVivaPowerOffRegs[i].addr == addr) {
+			break;
+		}
+	}
+	if (!gVivaHalting || i == sizeof(gVivaPowerOffRegs) / sizeof(gVivaPowerOffRegs[0]) || mask == 0 ||
+	    (mask & ~gVivaPowerOffRegs[i].mask) || (value & ~mask) ||
+	    (addr == MT6358_TOP_TMA_KEY && value != 0 && value != 0x9ca7)) {
+		IOLog("VIVA PWRAP: refused power-off write 0x%04x mask 0x%x <- 0x%x\n", addr, mask, value);
+		return kIOReturnNotPermitted;
+	}
+	uint32_t v = value;
+	if (!gVivaPowerOffRegs[i].whole) {
+		uint32_t old = 0;
+		IOReturn ret = readNoLock(addr, &old);
+		if (ret != kIOReturnSuccess) {
+			return ret;
+		}
+		v = (old & ~mask) | value;
+	}
+	if (WACS_FSM(rd32(PWRAP_WACS2_RDATA)) == WACS_FSM_WFVLDCLR) {
+		wr32(PWRAP_WACS2_VLDCLR, 1);
+	}
+	if (!waitFSM(WACS_FSM_IDLE)) {
+		return kIOReturnTimeout;
+	}
+	wr32(PWRAP_WACS2_CMD, 0x80000000u | ((addr >> 1) << 16) | (v & 0xffff));
+	return waitFSM(WACS_FSM_IDLE) ? kIOReturnSuccess : kIOReturnTimeout;
+}
+
+/* rtc_write_trigger: WRTGR = 1, then BBPU.CBUSY until the RTC has taken the writes (vendor: 500 ms max). */
+bool
+VivaPwrap::rtcWriteTrigger(void)
+{
+	if (writePowerOff(MT6358_RTC_WRTGR, 1, 1) != kIOReturnSuccess) {
+		return false;
+	}
+	for (int i = 0; i < 50000; i++) {
+		uint32_t bbpu = 0;
+		if (readNoLock(MT6358_RTC_BBPU, &bbpu) == kIOReturnSuccess && !(bbpu & RTC_BBPU_CBUSY)) {
+			return true;
+		}
+		IODelay(10);
+	}
+	return false;
+}

+	{ MT6358_RTC_BBPU, 0x433f, true },              /* key 0x43, RELOAD, CLRPKY/AUTO/INIT, CLR, PWREN */
+	{ MT6358_RTC_AL_MASK, RTC_AL_MASK_DOW, true },  /* only "mask DOW" */
+	{ MT6358_RTC_WRTGR, 0x0001, true },             /* write trigger */
+	{ MT6358_TOP_TMA_KEY, 0xffff, true },           /* 0x9ca7 / 0 only (checked below) */
+	{ MT6358_PSEQ_ELR11, RG_SDN_DLY_ENB, false },
+	{ MT6358_PPCCTL0, RG_PWRHOLD, false },          /* not RG_CRST/RG_WRST next to it */
+};

+	uint32_t i = wd.rxIdx[r];
+	viva_wifi_dma_flush(wd.rxDesc[r] + 16 * i, 16);
+	uint32_t d1 = desc(wd.rxDesc[r], i)[1];
 	if (!(d1 & DESC_DMADONE)) {
 		return NULL;
 	}
@@ -1108,6 +1112,7 @@
 {

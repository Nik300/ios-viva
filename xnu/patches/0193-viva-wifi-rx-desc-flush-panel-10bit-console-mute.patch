 	wd.rxGot[r]++;
@@ -1123,6 +1128,8 @@
 {
 	uint32_t i = wd.rxIdx[r], *d = desc(wd.rxDesc[r], i);
 	uint32_t didx = rd(WF_RX_RING(r) + 12) & 0xfff;

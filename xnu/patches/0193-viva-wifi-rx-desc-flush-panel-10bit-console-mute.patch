+	viva_wifi_dma_flush(wd.rxDesc[r] + 16 * ((i + 1) % wd.rxN[r]), 16);
 	if (didx == i || (d[1] & DESC_DMADONE) || !(desc(wd.rxDesc[r], (i + 1) % wd.rxN[r])[1] & DESC_DMADONE)) {

+IOReturn
+VivaAudio::newUserClient(task_t owningTask, void *securityID, UInt32 type, IOUserClient **handler)
+{
+	VivaAudioUserClient *uc = new VivaAudioUserClient;
+	if (uc == NULL) {
+		return kIOReturnNoMemory;
+	}
+	if (!uc->initWithTask(owningTask, securityID, type) || !uc->attach(this)) {
+		uc->release();
+		return kIOReturnError;
+	}
+	if (!uc->start(this)) {
+		uc->detach(this);
+		uc->release();
+		return kIOReturnError;
+	}
+	*handler = uc;
+	return kIOReturnSuccess;
+}
+
+bool
+VivaAudioUserClient::start(IOService *provider)
+{
+	fAudio = OSDynamicCast(VivaAudio, provider);
+	return fAudio != NULL && IOUserClient::start(provider);
+}
+
+IOReturn
+VivaAudioUserClient::clientClose(void)
+{
+	if (fStarted) {
+		fStarted = false;
+		fAudio->stopOutput();
+	}
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+VivaAudioUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target, __unused void *reference)
+{
+	switch (selector) {
+	case VA_UC_START: {
+		if (args->scalarInputCount != 2) {
+			return kIOReturnBadArgument;
+		}
+		uint32_t bytes;
+		volatile uint8_t *r = fAudio->ring(&bytes);
+		for (uint32_t i = 0; i < bytes; i += 4) {
+			*(volatile uint32_t *)(r + i) = 0;
+		}
+		IOReturn ret = fAudio->startOutput((uint32_t)args->scalarInput[0], args->scalarInput[1] != 0);
+		fStarted = ret == kIOReturnSuccess;
+		return ret;
+	}
+	case VA_UC_STOP:
+		fStarted = false;
+		return fAudio->stopOutput();
+	case VA_UC_HAPTIC: {
+		if (args->structureInput == NULL || args->structureInputSize < 4 + 4 * VA_HAPTIC_STEPS) {
+			return kIOReturnBadArgument;
+		}
+		uint32_t n = MIN(*(const uint32_t *)args->structureInput, (uint32_t)VA_HAPTIC_STEPS);
+		return viva_haptic_envelope((const uint8_t *)args->structureInput + 4, n) == 0 ? kIOReturnSuccess :
+		       kIOReturnNotReady;
+	}
+	default:
+		return kIOReturnUnsupported;
+	}
+}
+
+IOReturn
+VivaAudioUserClient::clientMemoryForType(UInt32 type, IOOptionBits *options, IOMemoryDescriptor **memory)
+{
+	IOMemoryDescriptor *md = type == VA_MAP_STATUS ? fAudio->statusMemory() :
+	    (type == VA_MAP_RING ? fAudio->ringMemory() : NULL);
+	if (md == NULL) {
+		return kIOReturnBadArgument;
+	}
+	md->retain();
+	*options = type == VA_MAP_STATUS ? kIOMapReadOnly : kIOMapWriteCombineCache;
+	*memory = md;
+	return kIOReturnSuccess;
+}

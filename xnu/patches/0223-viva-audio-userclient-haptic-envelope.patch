+/* VivaAudio.cpp (0223): the iOS actuator envelope, {ms, gain, reserved} x n */
+extern "C" int
+viva_haptic_envelope(const void *steps, uint32_t n)
+{
+	const uint8_t *b = (const uint8_t *)steps;
+	uint16_t ms[HAP_MAX_STEPS];
+	uint8_t gain[HAP_MAX_STEPS];
+	n = MIN(n, (uint32_t)HAP_MAX_STEPS);
+	for (uint32_t i = 0; i < n; i++) {
+		ms[i] = (uint16_t)(b[4 * i] | (b[4 * i + 1] << 8));
+		gain[i] = b[4 * i + 2];
+	}
+	return gVivaHaptic != NULL && gVivaHaptic->envelope(ms, gain, n) == kIOReturnSuccess ? 0 : -1;
+}

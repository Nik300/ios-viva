+IOReturn
+VivaHaptic::envelope(const uint16_t *ms, const uint8_t *gain, uint32_t n)
+{
+	struct {
+		uint32_t ms[HAP_MAX_STEPS];
+		uint8_t  gain[HAP_MAX_STEPS];
+	} p;
+	n = MIN(n, (uint32_t)HAP_MAX_STEPS);
+	for (uint32_t i = 0; i < n; i++) {
+		p.ms[i] = MIN((uint32_t)ms[i], 1000u);
+		p.gain[i] = MIN(gain[i], (uint8_t)0x80);
+	}
+	return fGate->runActionBlock(^IOReturn {
+		fTimer->cancelTimeout();
+		if (n == 0 || (n == 1 && p.gain[0] == 0)) {
+			if (fPlaying) {
+				stopGated();
+			}
+			fSteps = 0;
+			return kIOReturnSuccess;
+		}
+		bcopy(p.ms, fStepMs, n * sizeof(p.ms[0]));
+		bcopy(p.gain, fStepGain, n * sizeof(p.gain[0]));
+		fSteps = n;
+		fRepeat = false;
+		fEnvelope = true;
+		fStep = 0;
+		fEnvelopes++;
+		if (fStepGain[0] == 0 && fPlaying) {
+			stopGated();
+		} else if (fStepGain[0] != 0 && !fPlaying) {
+			driveGated(fStepGain[0]);
+		}
+		fTimer->setTimeoutMS(MAX(fStepMs[0], 1u));
+		return kIOReturnSuccess;
+	});
+}

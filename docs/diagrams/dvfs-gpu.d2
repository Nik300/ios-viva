# GPU DVFS control loop of ios-viva (kernel patches 0107/0115/0137, 0145/0147/0183/0192/0194).
# Rendered with D2 through kroki.io:
#   curl -X POST https://kroki.io/d2/svg -H 'Content-Type: text/plain' --data-binary @dvfs-gpu.d2 -o ../dvfs-gpu.svg
vars: {
  d2-config: {
    theme-id: 0
    layout-engine: elk
    pad: 24
  }
}
direction: right
classes: {
  sig: {style: {fill: "#eef4ff"; stroke: "#4a7bd0"; border-radius: 8; font-size: 14}}
  gov: {style: {fill: "#fff4e0"; stroke: "#d08a2a"; stroke-width: 2; border-radius: 10; font-size: 15}}
  cap: {style: {fill: "#fdecec"; stroke: "#c84b4b"; border-radius: 8; font-size: 14}}
  hw: {style: {fill: "#e9f7ee"; stroke: "#3c9a5f"; border-radius: 8; font-size: 14}}
  lane: {style: {fill: "#fafafa"; stroke: "#9aa0a6"; stroke-dash: 3; border-radius: 12; font-size: 18; bold: true}}
  limit: {style: {stroke: "#c84b4b"; stroke-dash: 4}}
}

in: "Inputs" {
  style.fill: transparent
  style.stroke: transparent
  load: "Share of time a job chain\nwas on the hardware (50 ms window)" {class: sig}
  wait: "Display had a frame queued\nthat the GPU had not finished" {class: sig}
}
gov: "GPU governor\n\nbusy >= 85 % or display waiting: fastest OPP\nelse slowest OPP <= 70 % busy\nno step down for 200 ms after a step up" {class: gov}
caps: "Ceilings" {
  style.fill: transparent
  style.stroke: transparent
  lpm: "Low Power Mode: 550 MHz\nvivagpufreq (floor), vivagpufreqmax" {class: cap}
}
out: "Hardware" {
  style.fill: transparent
  style.stroke: transparent
  mali: "Mali-G57 MC2\n300 - 950 MHz, 49 OPPs\nVGPU + VSRAM_GPU + MFGPLL" {class: hw}
}
in.load -> gov
in.wait -> gov: "boost"
caps.lpm -> gov {class: limit}
gov -> out.mali: "rails stepped 50 mV at a time,\njobs keep running (~1 ms)"
